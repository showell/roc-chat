# gopher-roc in prod, https://chat.lynrummy.com. The prod droplet's Caddyfile
# (angry-gopher's deploy/Caddyfile) imports /etc/caddy/sites/*.caddy, where
# tools/deploy.shale installs this file beside lynrummy.com's and
# roc.lynrummy.com's site blocks. Every request is logged to
# /var/log/caddy/chat-access.log by the `access_log` snippet that Caddyfile
# defines for every site on prod.
#
# **CADDY TERMINATES HTTPS AND PASSES THE REQUEST THROUGH AS IT CAME**: the
# app holds every request to its own origin from its head (Host, Origin,
# Sec-Fetch-Site, Sec-Fetch-Mode; app/RequestOrigin.roc), and finds who is
# acting from Cookie or Authorization. reverse_proxy keeps all of them by
# default, Host included, so nothing here may set, rewrite or strip one, and
# no path prefix is added: a rewritten Host or Origin is a 403 from the app.
# Caddy caches nothing unless told to; nothing here tells it to.
chat.lynrummy.com {
	import access_log chat
	# **NEVER AN EVENT STREAM**: gzip buffers what it compresses, so an SSE
	# frame could sit in the encoder instead of reaching the browser. Only
	# the types listed are compressed; text/event-stream is not among them.
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
		}
	}

	# The outer cap: the app's largest admission, an upload's 10 MiB image
	# and 64 KiB of form (`upload_body_allowance` in app/main.roc,
	# 10,551,296 bytes). The app refuses past its own cap per route.
	request_body {
		max_size 10551296
	}

	# The security headers are lynrummy.com's.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# **A STREAM IS WRITTEN THROUGH AS IT COMES**: flush_interval -1, so an
	# SSE frame reaches the browser at once and is never held in a buffer.
	# No timeout here ends one: the app ends a stream after an hour
	# (`Limits.stream_most_ms`), and Caddy sets no stream or read timeout
	# unless told. A Caddy reload ends every stream; the clients reconnect.
	reverse_proxy 127.0.0.1:9611 {
		flush_interval -1
	}
}
