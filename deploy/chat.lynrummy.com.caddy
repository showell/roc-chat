# This is gopher-roc's site block on the prod droplet, for
# https://chat.lynrummy.com. tools/deploy.shale installs it as
# /etc/caddy/sites/chat.lynrummy.com.caddy, in roc-chat's block's place. The
# droplet's Caddyfile (angry-gopher's deploy/Caddyfile) imports that folder and
# defines the `access_log` snippet, which logs every request to
# /var/log/caddy/chat-access.log.
#
# Caddy terminates HTTPS and passes each request through as it came. The app
# holds every request to its own origin from its Host, Origin, Sec-Fetch-Site
# and Sec-Fetch-Mode (app/RequestOrigin.roc), and finds who is acting from its
# Cookie or Authorization. reverse_proxy keeps all of them by default, Host
# included, so nothing here may set, rewrite or strip one, and no path prefix
# is added: the app answers a rewritten Host or Origin with a 403.
#
# The host caps each client's requests in flight by the X-Forwarded-For that
# reverse_proxy sets, so trusted_proxies must not let a client's own copy in.
# docs/deploy.md, "The per-client cap", says what bounds a client.
chat.lynrummy.com {
	import access_log chat
	# Gzip buffers what it compresses, which would hold back an event stream.
	# Only the types listed here are compressed, and text/event-stream is not
	# among them.
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
		}
	}

	# This is the app's largest admission, an upload's 10 MiB image and 64 KiB
	# of form (`upload_body_allowance` in app/main.roc). The app holds each
	# route to its own smaller cap.
	request_body {
		max_size 10551296
	}

	# These security headers are lynrummy.com's.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# flush_interval -1 writes an event through as it comes. No timeout is set
	# here, so the app ends a stream itself after an hour
	# (`Limits.stream_most_ms`). A Caddy reload ends every stream, and the
	# clients reconnect.
	reverse_proxy 127.0.0.1:9611 {
		flush_interval -1
	}
}
