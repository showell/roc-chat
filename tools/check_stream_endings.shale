-- This check holds the app to one rule (docs/design.md, "Streams"): every
-- action that ends a session, revokes a credential or removes someone's
-- access also ends the affected user's open streams, since the host judges
-- a stream once, when it opens, and holds it up to an hour.
--
--   shale tools/check_stream_endings.shale
--
-- Roc's types hold most of the rule: a revoking writer takes a
-- `UserStreams.Revoker`, and only `UserStreams.with_streams_ended!` makes
-- one, ending the user's streams after the writes, however they went; the
-- body it runs answers no value, so no `Revoker` outlives it. What the types
-- can't see is which writers revoke, and this check holds that part.
--
-- It reads app/*.roc (not the specs) through Roc's own parse tree
-- (`roc_tree`), each top-level function and each function of a module's
-- type by its `Module.name`, with the calls in its body by name and the
-- types its annotation's arguments name, and tools/stream_endings.txt, the
-- table of every function that writes a file (calls a FileFacts writer, as
-- tools/file_writers.txt lists them, the list
-- tools/check_credential_writers.shale reads too): `ends` (its write ends a
-- session, credential or access), `may_end` (it does or not, as its value
-- says), `keeps` (it doesn't), or `exempt` (a call of a `may_end` writer
-- that removes no one). Its findings:
--
--   unjudged_writer   a function that writes a file and has no `ends`,
--                     `may_end` or `keeps` line, so a new writer is judged
--                     when it comes;
--   stale_entry       a line for no function, a verdict for a function that
--                     writes no file, or an `exempt` line for a call the
--                     function doesn't make or of no `may_end` writer;
--   unguarded_writer  an `ends` writer whose annotation takes no
--                     `UserStreams.Revoker`, so a caller could revoke
--                     without ending streams;
--   unjudged_call     a call of a `may_end` writer from a function that
--                     neither takes a `UserStreams.Revoker` nor has an
--                     `exempt` line for it;
--   stray_ending      `Host.end_every_stream_of_holder!` called anywhere but
--                     `UserStreams.end_every_stream!`;
--   unended_holder    a `StreamHolder` function that makes a holder (every
--                     one but `to_bytes`) that `UserStreams.end_every_stream!`
--                     doesn't call, so a stream held under it would outlive
--                     every revocation;
--   stray_holder      a record field `stream_holder` set in any module but
--                     `HttpAnswer`. `Http.Response` is the platform's plain
--                     record, so Roc's types let any module name a holder;
--                     `HttpAnswer.stream`, which takes a `StreamHolder`, is
--                     the one place that sets it to a holder (its `Whole`
--                     answer sets it empty), and this finding holds every
--                     other module to that, so every stream is held under
--                     a name `StreamHolder` makes.
--
-- What the check can't see: a `may_end` call it is told removes no one
-- (each `exempt` line is a reader's judgement), and a write that reaches
-- the host's files other than through FileFacts, which CLAUDE.md's rule
-- (only FileFacts touches files) keeps out.
--
-- It prints each finding, then `stream-endings N`, and fails on any.
-- budget: steps=300000000 arena_bytes=1000000000 reads=20000 kept_bytes=64000000

const TABLE = "tools/stream_endings.txt"
const ENDING = "UserStreams.end_every_stream!"
const HOST_ENDING = "Host.end_every_stream_of_holder!"
const REVOKER = "UserStreams.Revoker"
const WRITER_LIST = "tools/file_writers.txt"

-- FileFacts' writers, as `FileFacts.name!`.
function file_writers()
  local found = {}
  for l in lines(read(WRITER_LIST)) do
    local t = trim(l)
    if t ~= "" and not starts_with(t, "#") then push(found, "FileFacts." .. t) end
  end
  if #found == 0 then fail("check_stream_endings: " .. WRITER_LIST .. " names no writer") end
  return found
end
const WRITERS = file_writers()

-- Whether the node at `i` of `f` is a top-level statement: of a module's
-- type, or of the file.
function is_top(f, i)
  local holder = f.nodes[f.nodes[i].parent]
  return holder.kind == "associated" or (holder.kind == "statements" and f.nodes[holder.parent].kind == "file")
end

-- Every function of the file at `p`, whose tree is `f`, by `Module.name`,
-- each with its line, the calls in its body, `{name, line}`, a bare name
-- as it is written, and `takes`, the types its annotation's arguments
-- name.
function functions_of(p, f)
  local module = sub(basename(p), 1, #basename(p) - 4)
  local found = {}
  local takes = {}
  local current = nil
  local depth = -1
  for i = 1, #f.nodes do
    local n = f.nodes[i]
    if current ~= nil and n.depth <= depth then current = nil end
    if current == nil and n.kind == "s-type-anno" and n.parent > 0 and is_top(f, i) then
      local named = {}
      for k in n.kids do
        if f.nodes[k].kind == "ty-fn" then
          for a in f.nodes[k].kids do push(named, get(f.nodes[a], "name", "")) end
        end
      end
      takes[module .. "." .. get(n, "name", "")] = named
    end
    if current == nil and n.kind == "s-decl" and n.parent > 0 and is_top(f, i) then
      local named = f.nodes[n.kids[1]]
      if named.kind == "p-ident" then
        local name = module .. "." .. get(named, "raw", "")
        current = {name = name, module = module, line = n.line, calls = {}, takes = get(takes, name, {})}
        depth = n.depth
        push(found, current)
      end
    end
    if current ~= nil and n.kind == "e-ident" then push(current.calls, {name = get(n, "raw", ""), line = n.line}) end
  end
  return found
end

-- The table's lines, `{verdict, name, line}`, and an `exempt` line's
-- `callee` too.
function read_table()
  local rows = {}
  local at = 0
  for l in lines(read(TABLE)) do
    at = at + 1
    local t = trim(l)
    if t ~= "" and not starts_with(t, "#") then
      local w = words(t)
      if #w < 3 or not has_item({"ends", "may_end", "keeps", "exempt"}, w[1]) or (w[1] == "exempt" and #w < 4) then fail(TABLE .. ":" .. at .. ": not `ends|may_end|keeps Module.name why` or `exempt Module.name Callee.name why`: " .. t) end
      local row = {verdict = w[1], name = w[2], line = at, callee = ""}
      if w[1] == "exempt" then row.callee = w[3] end
      push(rows, row)
    end
  end
  return rows
end

-- Every record field `stream_holder` set in a module but `HttpAnswer`,
-- found by Roc's tree: a record's field is a `field` node with no line of
-- its own, so its line is its record's.
function stray_holders(p, f)
  if p == "app/HttpAnswer.roc" then return {} end
  local found = {}
  for n in f.nodes do
    if n.kind == "field" and get(n, "field", "") == "stream_holder" then
      local at = n
      while at.line == 0 and at.parent > 0 do at = f.nodes[at.parent] end
      push(found, p .. ":" .. at.line)
    end
  end
  return found
end

const funcs = {}
const strays = {}
for p in glob("app/*.roc") do
  if not ends_with(p, "Spec.roc") and p ~= "app/Specs.roc" then
    local f = roc_tree({p})[1]
    if f.err ~= "" then fail("check_stream_endings: roc-ast refused " .. p .. ": " .. f.err) end
    for fn in functions_of(p, f) do funcs[fn.name] = fn end
    for s in stray_holders(p, f) do push(strays, s) end
  end
  yield()
end

-- A call by its bare name is to the module's own function of that name.
for name in keys(funcs) do
  local fn = funcs[name]
  for c in fn.calls do
    if find(c.name, ".") == nil and has_key(funcs, fn.module .. "." .. c.name) then c.name = fn.module .. "." .. c.name end
  end
end

const rows = read_table()
const verdict = {}
const exempt = {}
for r in rows do
  if r.verdict == "exempt" then exempt[r.name .. " " .. r.callee] = true else verdict[r.name] = r.verdict end
end

const findings = {}
function finding(kind, text) push(findings, kind .. ": " .. text) end

function writes_a_file(fn)
  for c in fn.calls do
    if has_item(WRITERS, c.name) then return true end
  end
  return false
end

function calls(fn, name)
  for c in fn.calls do
    if c.name == name then return true end
  end
  return false
end

function where(fn, line) return "app/" .. fn.module .. ".roc:" .. line end

-- Every writer judged, and every line naming a function as it is.
local names = keys(funcs)
sort(names)
for name in names do
  local fn = funcs[name]
  if fn.module ~= "FileFacts" or name == "FileFacts.create_facts_from!" then
    if writes_a_file(fn) and get(verdict, name, "") == "" then
      finding("unjudged_writer", name .. " (" .. where(fn, fn.line) .. ") writes a file and has no `ends`, `may_end` or `keeps` line in " .. TABLE)
    end
  end
end
for r in rows do
  if not has_key(funcs, r.name) then
    finding("stale_entry", TABLE .. ":" .. r.line .. ": " .. r.name .. " is no function in app/")
  elseif r.verdict == "exempt" then
    if not (calls(funcs[r.name], r.callee) and get(verdict, r.callee, "") == "may_end") then
      finding("stale_entry", TABLE .. ":" .. r.line .. ": " .. r.name .. " is exempt for " .. r.callee .. ", which it doesn't call or which is no `may_end` writer")
    end
  elseif not writes_a_file(funcs[r.name]) then
    finding("stale_entry", TABLE .. ":" .. r.line .. ": " .. r.name .. " writes no file")
  end
end

for name in names do
  local fn = funcs[name]
  if get(verdict, name, "") == "ends" and not has_item(fn.takes, REVOKER) then
    finding("unguarded_writer", where(fn, fn.line) .. ": " .. name .. " revokes and takes no " .. REVOKER)
  end
  for c in fn.calls do
    if get(verdict, c.name, "") == "may_end" and not has_item(fn.takes, REVOKER) and not has_key(exempt, name .. " " .. c.name) then
      finding("unjudged_call", where(fn, c.line) .. ": " .. name .. " calls " .. c.name .. ", takes no " .. REVOKER .. " and has no `exempt` line")
    end
    if c.name == HOST_ENDING and name ~= ENDING then
      finding("stray_ending", where(fn, c.line) .. ": " .. name .. " ends streams itself; " .. ENDING .. " is the one place")
    end
  end
end

-- Every holder StreamHolder makes, ended.
if not has_key(funcs, ENDING) then fail("check_stream_endings: no " .. ENDING .. " in app/") end
for name in names do
  if funcs[name].module == "StreamHolder" and name ~= "StreamHolder.to_bytes" and not calls(funcs[ENDING], name) then
    finding("unended_holder", "app/StreamHolder.roc:" .. funcs[name].line .. ": " .. ENDING .. " never ends the streams held under " .. name)
  end
end

for s in strays do
  finding("stray_holder", s .. ": sets a response's stream_holder; HttpAnswer.stream, given a StreamHolder, is the one place")
end

for l in findings do print(l) end
print("stream-endings " .. #findings)
if #findings > 0 then fail("check_stream_endings: " .. #findings .. " findings") end
