-- **THE CONVERSATION KIND'S REMNANTS, OFF PROD** (Steve, 2026-11-01):
-- conversations 1, 3, 4 and 5, the kind with no topic, are no more; the
-- chat no longer reads their files. Run once, from roc-chat's root, after
-- the deploy that removed the kind:
--
--   shale tools/remove_conversations.shale
--
-- No arguments. Over ssh, as the deploy works, each step refusing by name
-- what it cannot do:
-- 1. Lists the conversation records on prod, and stops, naming them, when
--    they are not exactly 1, 3, 4 and 5: nothing Steve did not name is
--    touched.
-- 2. Moves, never deletes, every remnant of the kind into one folder beside
--    the data, `/var/lib/roc-chat/removed-conversations-<date>`: the
--    records (`chat/conversations`), their transcripts, offsets and tallies
--    (`chat/transcripts`, `chat/offsets`, `chat/tallies`), and the indexes
--    of them (`chat/by-human`, `chat/started-by`, `chat/indexed`). Putting
--    the folder back undoes it; removing it is Steve's.
-- 3. Says what is left that the kind leaves behind and the chat no longer
--    reads: keys and agent invites narrowed with `only:` (none of which
--    decodes now), by count, never by secret.
--
-- budget: steps=5000000

const HOST = "steve@162.243.1.123"
const HOME = "/var/lib/roc-chat"
const DATA = HOME .. "/data"
const NAMED = "1 3 4 5"
const REMNANTS = {"chat/conversations", "chat/transcripts", "chat/offsets", "chat/tallies", "chat/by-human", "chat/started-by", "chat/indexed"}

if not exists("deploy/config.zon") then fail("remove: run it from roc-chat's root") end

-- A command on prod: it must succeed.
function on_prod(script)
  return must(run({"ssh", HOST, script}, {timeout_ms = 60000, whole = 100000, want = "ssh: the removal's steps on prod"}))
end

-- A command on prod whose exit is an answer: 0 yes, 1 no.
function asks_prod(script)
  local r = run({"ssh", HOST, script}, {timeout_ms = 60000, whole = 100000, want = "ssh: a question to prod, its exit the answer"})
  if r.code ~= 0 and r.code ~= 1 then fail("remove: prod could not be asked (ssh exit " .. r.code .. "): " .. trim(r.out)) end
  return r.code == 0
end

-- 1. The records there, exactly the named ones.
if not asks_prod("sudo test -d " .. DATA .. "/chat/conversations") then fail("remove: " .. DATA .. "/chat/conversations is not on prod; nothing to remove") end
local listed = trim(on_prod("sudo ls " .. DATA .. "/chat/conversations | sort -n | tr '\\n' ' '").out)
print("conversation records on prod: " .. listed)
if listed ~= NAMED then fail("remove: the records are `" .. listed .. "`, not `" .. NAMED .. "`; nothing was moved. Steve names which go.") end

-- 2. Every remnant, moved whole into one dated folder beside the data.
local stamp = trim(on_prod("date -u +%Y%m%d-%H%M%S").out)
const AWAY = HOME .. "/removed-conversations-"
local away = AWAY .. stamp
if asks_prod("sudo test -e " .. away) then fail("remove: " .. away .. " is there already") end
on_prod("sudo -u rocchat mkdir -p " .. away .. "/chat")
for path in REMNANTS do
  if asks_prod("sudo test -e " .. DATA .. "/" .. path) then
    on_prod("sudo -u rocchat mv " .. DATA .. "/" .. path .. " " .. away .. "/" .. path)
    print("moved " .. path)
  else
    print("none: " .. path)
  end
end
for path in REMNANTS do
  if asks_prod("sudo test -e " .. DATA .. "/" .. path) then fail("remove: " .. DATA .. "/" .. path .. " is still there") end
end

-- 3. What the kind leaves that the chat no longer reads.
-- The glob and the pipe are root's too (`sh -c`): the ssh user's shell
-- cannot list the folder, and its `*` would match nothing.
local keys = trim(on_prod("sudo sh -c \"grep -lE ' (read|post)=only:' " .. DATA .. "/auth/keys/* 2>/dev/null | wc -l\"").out)
local invites = trim(on_prod("sudo sh -c \"grep -lE ' (read|post)=only:' " .. DATA .. "/auth/invites/* 2>/dev/null | wc -l\"").out)
print("keys narrowed with only: (no key now): " .. keys .. "; agent invites so narrowed: " .. invites)
print("the conversation kind's remnants are in " .. away .. "; put back, they undo this, and removing them is Steve's")
