-- Screenshots of roc-chat's pages, so an agent can see what it changed.
-- It starts the chat on a throwaway data root seeded from the demo, signs
-- Steve in, invites Tam, writes a DM between them, invites Ada (who
-- writes to Steve) and Cy, and saves a PNG of each
-- page, in each theme, at a desktop's size and a phone's, and of what a
-- click or a key opens. Run it from roc-chat's root, naming the folder the
-- PNGs go to (made if missing):
--
--   shale tools/screenshot.shale out=build:shots/my-change
--
-- Each PNG is `<theme>-<width>x<height>-<page>.png`. The pages, at
-- 1280x800 and 390x844 (a phone):
--   channel  /chat/channel/general/roc-chat, the demo's topic, with the
--            keyboard help beside it at the desktop's size
--   dm       /chat/dm/1_2/plans, Steve and Tam
--   recent   /chat/recent
--   browse   /chat
--   invites  /invites
--   devices  /devices, the "Add a device" page's steps
-- and what takes a click or a key, at 1280x800 (STATES, below):
--   dm-person-card    Tam's name clicked in the sidebar: the person card
--   dm-own-card       Steve's own name clicked: his card, "Online now", green
--   dm-new-topic      the DM's "+" clicked: its card on the new-topic form,
--                     the topics under it
--   channel-card      #general's name clicked: the channel's card, its
--                     members by who posted lately (Tam, Ada), then the
--                     rest (Cy, CC the agent, Steve)
--   channel-member    a member's name clicked in it: their card in its
--                     place, with the way back to #general
--   dm-card-topic     Tam's name clicked, `kickoff` typed and Enter, no
--                     mouse after the click: the new topic's page
--   dm-selected       ↑ pressed twice: an older message selected
--   channel-compose   `c` pressed and a message typed: the compose rail
--                     open, where the keyboard help was
--   channel-emoji     `:sm` typed in the compose box: emoji autocomplete
--   channel-c-escape, dm-c-escape, channel-button-escape, dm-button-escape
--                     the box opened by `c` or its button, then Escape: the
--                     empty box closed (each `wait`s for it, so a box left
--                     open stops the run)
--   channel-text-escape  text typed, then Escape: the box open, the text kept
--   channel-close-reopen text typed, the rail's ✕, then `c`: the text back
--   channel-ctrl-enter   text typed, then Ctrl+Enter: the "✓ sent" notice
--   devices-code      "Make a code" pressed: the code shown, large, in step 2
--   browse-bad-topic  "two words" sent as a topic: the refusal beside its
--                     place's form, which keeps what was typed
--   invite-made       Tam's "New link" pressed: the link's card, the form
--                     behind "Invite someone else", and the address
--                     /invites, not the POST's, so a reload makes no invite
--   invite-taken      "tam" sent as a new name: the refusal under the form,
--                     which keeps the name
-- and at 390x844 (a state's `size`):
--   channel-escape    the open bar tapped, then Escape: closed to the
--                     green "Open compose box" button
--   dm-actions        the selected message's "⋯" tapped: its row of
--                     actions open under its header
--   sign-out-focus    the top bar's "Sign out" focused, as Tab reaches it
--                     (at both sizes)
--   invite-made-phone the invite-made card at a phone's width
--   dm-drawer         the ☰ tapped: the sidebar's drawer, its dots
-- and at 1280x800 again:
--   recent-search     Recent's 🔍 clicked and "thu" typed: the words found
--   recent-arrival    a message sent while Recent is open: its tile arrived
--                     live, glowing
--   dm-message-notice the notice of a message elsewhere, as the stream's
--                     `message-notice` shows it (here handed to chrome.js's
--                     Notices by the page's console), at both sizes
--   dm-notice-dismissed  on a phone, that notice's ✕ tapped: the line gone
--   channel-self-notice  Steve, on the channel's page, sends a message to his
--                     own DM: its violet notice arrives live (at both sizes)
--   dm-here-away      a message from Tam on the topic being read, the page
--                     not focused: the strip says nothing, the tab turns
--                     violet, and clears once the page has the focus again
--                     (the state waits on each; the picture is the page)
--   dm-here-focused   the same message, the page focused: no violet
--   sign-out-confirm  a phone signed in by a device code taps "Sign out":
--                     the page that asks first (at both sizes; a state with
--                     `as = "phone"` uses that device's session)
--   dm-cite, channel-cite, own-dm-cite
--                     Home, then `l`, on Tam's DM, #general and Steve's own
--                     DM (its topic `notes`): the citation of the first
--                     message the clipboard gets, its text shown over the
--                     messages (the clipboard caught by the page's
--                     console), each `wait`ing for the link's words and
--                     path, the "copied" notice and the compose box's
--                     placeholder, which names the place too
--   cite-followed     the DM's first message cited, the citation pasted in
--                     its ChitChat, and its link followed: that message
--                     selected on its page
--   citation-pasted   that citation in ChitChat, its link under the quote
--                     (at both sizes)
--   dm-quote-reply    `q`: the selected message quoted in the open box
-- and once, last, in the last theme (it brings Cy online for good, so
-- every picture before it shows his hollow dot):
--   dm-came-online    Cy's first page, while Steve's DM is open: his dot
--                     filled by the stream, and "Cy has come online."
-- in dark (the app's default) and light. `themes=dark` or `sizes=phone`
-- (or `desktop`) takes one alone; `states=0` leaves the STATES out.
--
-- Lanes run it at once, so each picks its own port: the first one free
-- (nothing listening, by `ss`) of PORTS, starting at a place its folder's
-- path picks; `port=` names one instead. The server takes its port with
-- SO_REUSEPORT, so a second server on a taken port starts without a word
-- and the two share its connections: once ours is up, the script stops
-- unless ours is the port's one listener, so it never posts to another
-- lane's chat.
--
-- The browser is Chrome for Testing's chrome-headless-shell, pinned under
-- Shale's `tools` mount (CHROME, below), driven by tools/shot/ (a small
-- Zig program, its own build apart from the server's) through the
-- DevTools protocol over a pipe: one browser for every picture, each step
-- of a list this script writes (tools/shot/steps.zig says the steps).
-- The session cookie and the theme (localStorage's `chat-theme`) are set
-- through the protocol, so no page of ours hands them over. Its sandbox
-- needs unprivileged user namespaces, which this box's AppArmor refuses,
-- so it runs with `--no-sandbox`, and it loads only this local chat.
--
-- Budgets: about 70 s on a busy box for the 105 pictures once the server and the driver
-- are built (10 to 12.6 s of CPU on 2026-11-20, about 0.1 s a picture,
-- held to 16 s with the citation states; it was 2.5 s for 56, and the
-- states added since cost more each, popups and waits); each about 0.5 s, its line
-- printed as `shot <name> <ms>`. A `zig build` after the app changed adds
-- about 25 s, the driver's first build about 10 s.
-- The browser runs one renderer, its JavaScript heap capped at 128 MB,
-- under `nice`. The data root, the profile, the list and the logs are
-- under .zig-cache/screenshot.XXXXXX, removed at the end; a stop leaves
-- them, and its jobs (the server) end with it.

const CHROME = "tools:chrome-headless-shell-158.0.8127.36/chrome-headless-shell-linux64/chrome-headless-shell"
const PASSWORD = "correct horse battery staple"

local out = arg("out", "")
if out == "" then fail("screenshot: name the folder the PNGs go to, out=build:shots/<name>") end
local port_arg = arg("port", 0)
local themes_arg = arg("themes", "dark,light")
local sizes_arg = arg("sizes", "desktop,phone")
local with_states = arg("states", 1) == 1

const PAGES = {
  {name = "channel", path = "/chat/channel/general/roc-chat"},
  {name = "dm", path = "/chat/dm/1_2/plans"},
  {name = "recent", path = "/chat/recent"},
  {name = "browse", path = "/chat"},
  {name = "invites", path = "/invites"},
  {name = "devices", path = "/devices"},
}
const SIZES = {desktop = "1280 800", phone = "390 844"}

-- Where a port is looked for: 100 of them.
const PORTS_FROM = 9661
const PORTS = 100

-- The pids listening on TCP `at`, by `ss` (one line a socket).
function listeners(at)
  local r = must(run({"ss", "-Hltnp", "sport = :" .. at}, {timeout_ms = 5000, tail = 20}))
  local pids = {}
  for l in re_lines(r.out, ".") do
    local m = re_find(l.text, "pid=([0-9]+)")
    if m == nil then fail("screenshot: a listener on port " .. at .. " with no pid shown: " .. l.text) end
    push(pids, tonumber(m.group))
  end
  return pids
end

-- The first port of PORTS nothing listens on, from a place this checkout's
-- path picks, so two lanes seldom try the same one first.
function free_port()
  local path = real(".")
  local start = 0
  for i = 1, #path do
    local at = find("abcdefghijklmnopqrstuvwxyz0123456789-_./", sub(path, i, i))
    if at == nil then at = 0 end
    start = (start * 31 + at) % PORTS
  end
  for i = 0, PORTS - 1 do
    local at = PORTS_FROM + (start + i) % PORTS
    if #listeners(at) == 0 then return at end
  end
  fail("screenshot: no free port in " .. PORTS_FROM .. "-" .. (PORTS_FROM + PORTS - 1))
end

-- Stops the run unless `pid` is the one process listening on `at`.
function alone_on(at, pid)
  local listening = listeners(at)
  if #listening ~= 1 or listening[1] ~= pid then
    fail("screenshot: port " .. at .. " has listeners " .. join(listening, ",") .. ", not our server (" .. pid .. ") alone: another chat shares it, so its pages may be the other's; run again, or name a port with port=")
  end
end

-- The clipboard, as `l` writes a citation to it: the text shown on the
-- page, and held in its data-text for a `wait` to read.
const CAPTURE = [==[eval window.ClipboardItem = undefined; Object.defineProperty(navigator, 'clipboard', {configurable: true, value: {writeText: function (t) { var p = document.createElement('pre'); p.id = 'cite-seen'; p.textContent = t; p.setAttribute('data-text', t); p.style.cssText = 'position:fixed;top:60px;left:280px;z-index:99;background:#fff;color:#000;padding:8px;white-space:pre-wrap;max-width:700px;font-size:14px'; document.body.appendChild(p); return Promise.resolve(); }}})]==]

-- A message Steve sends to his own DM once the page's stream is open, which
-- is news to him on any other page (app/MessageNotice.roc's `recipients`).
const SELF_NOTICE = {
  "eval new Promise(function (r) { setTimeout(r, 700); })",
  "eval fetch('/chat/dm/1_1/notes', {method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: 'markdown=' + encodeURIComponent('A note to myself.')})",
  "wait .notice-strip.notice-message"}

-- The notice of a message of Tam's in the channel, as the stream's
-- `message-notice` brings it (app/MessageNotice.roc's words and link).
