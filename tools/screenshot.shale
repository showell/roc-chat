if not exists(CHROME) then fail("screenshot: no browser at " .. CHROME .. "; Chrome for Testing's chrome-headless-shell, that version, unzipped there") end

-- A form POSTed as `cookie` (a `name=value`), each field's value
-- URL-encoded by curl: the answer's status, headers and body.
function post_form(base, cookie, path, fields)
  local argv = {"curl", "-s", "-D", "-", "-H", "Cookie: " .. cookie}
  for f in fields do
    push(argv, "--data-urlencode")
    push(argv, f)
  end
  push(argv, base .. path)
  local r = must(run(argv, {timeout_ms = 10000, whole = 200000}))
  local status = re_find(r.out, "^HTTP/1\\.1 ([0-9]+)")
  if status == nil then fail("screenshot: POST " .. path .. " gave no status: " .. sub(r.out, 1, 200)) end
  return {status = tonumber(status.group), text = r.out}
end

-- The session cookie a 303's `Set-Cookie` sets, as `name=value`.
function cookie_of(answer, what)
  local c = re_find(answer.text, "(?:^|\n)[Ss]et-[Cc]ookie: (__Host-gopher_auth=[^;\r\n]+)")
  if c == nil then fail("screenshot: " .. what .. " set no session cookie (" .. answer.status .. ")") end
  return c.group
end

function expect_status(answer, want, what)
  if answer.status ~= want then fail("screenshot: " .. what .. ": " .. answer.status .. ", not " .. want .. "\n" .. sub(answer.text, 1, 400)) end
end

-- The steps that make `theme` the page's: localStorage, which belongs to
-- the chat's origin, so a page of it is loaded first.
function theme_steps(list, theme)
  push(list, "goto /chat")
  if theme == "light" then
    push(list, "eval localStorage.setItem('chat-theme', 'light')")
  else
    push(list, "eval localStorage.removeItem('chat-theme')")
  end
end

-- 0. The server and the driver, built niced, so the job below starts at once.
must(run({"zig", "build"}, {timeout_ms = 600000, tail = 20, nice = 19}))
must(run({"zig", "build", "install"}, {cwd = "tools/shot", timeout_ms = 300000, tail = 20, nice = 19}))

local work = fresh_dir(".zig-cache", "screenshot")
local data = work .. "/data"
mkdir(work .. "/profile")
mkdir(out)

const themes = split(themes_arg, ",")
const sizes = split(sizes_arg, ",")
for t in themes do
  if t ~= "dark" and t ~= "light" then fail("screenshot: themes= takes dark and light, not " .. t) end
end
for s in sizes do
  if not has_key(SIZES, s) then fail("screenshot: sizes= takes desktop and phone, not " .. s) end
end

-- 1. The chat, on the demo's topic; its first start makes Steve.
local port = port_arg
if port == 0 then port = free_port() end
mkdir(data)
copy("demo/data/chat", data .. "/chat")
local base = "http://localhost:" .. port
local server = job_start({"zig", "build", "serve", "--", real(data), "--port", "" .. port}, {log = work .. "/server.log"})
local up = job_wait(server, {timeout_ms = 60000, contains = "roc-chat: http://"})
if up.ended ~= "found" then fail("screenshot: the server did not start (" .. up.ended .. "); see " .. work .. "/server.log") end
-- Ours is the one process serving this data root, and it must be the
-- port's one listener, now and once the pictures are taken.
local ours = {}
for p in procs() do
  if p.name == "roc-chat" and find(p.args, real(data)) ~= nil then push(ours, p.pid) end
end
if #ours ~= 1 then fail("screenshot: " .. #ours .. " processes serve " .. data .. ", not 1") end
const server_pid = ours[1]
alone_on(port, server_pid)

local hashed = must(run({"zig", "build", "serve", "--", "hash-password"}, {stdin = PASSWORD .. "\n", timeout_ms = 60000, tail = 3}))
create(data .. "/auth/1/password", trim(hashed.out) .. "\n")
local steve = cookie_of(post_form(base, "none=1", "/login", {"name=Steve", "password=" .. PASSWORD, "next=/chat"}), "Steve's sign-in")

-- 2. Tam, invited and joined, and a DM between them.
local invited = post_form(base, steve, "/invites", {"name=Tam"})
expect_status(invited, 200, "inviting Tam")
local code = re_find(invited.text, "/join#([A-Za-z0-9_-]+)")
if code == nil then fail("screenshot: inviting Tam showed no /join# link") end
local joined = post_form(base, "none=1", "/join", {"code=" .. code.group, "name=Tam", "password=" .. PASSWORD})
expect_status(joined, 303, "Tam joining")
local tam = cookie_of(joined, "Tam's join")

expect_status(post_form(base, steve, "/chat/dm/1_2", {"topic=plans"}), 303, "the DM's topic")
const DM = {
  {who = "steve", text = "Shall we meet **Thursday**? I can bring the draft of `docs/design.md`."},
  {who = "tam", text = "Thursday works. Two things first:\n\n- the sidebar on a phone\n- the person card's DM list"},
  {who = "steve", text = "Good. Here's the check I run:\n\n```shale\nshale tools/screenshot.shale out=build:shots/thursday\n```"},
  {who = "tam", text = "> the sidebar on a phone\n\nI'll look at that one tonight."},
}
for m in DM do
  local who = steve
  if m.who == "tam" then who = tam end
  expect_status(post_form(base, who, "/chat/dm/1_2/plans", {"markdown=" .. m.text}), 303, "a DM message")
end

-- Steve's own DM, a topic with a note, for `l` there.
expect_status(post_form(base, steve, "/chat/dm/1_1", {"topic=notes"}), 303, "Steve's own DM's topic")
expect_status(post_form(base, steve, "/chat/dm/1_1/notes", {"markdown=A note to **myself**."}), 303, "a note to self")

-- 2b. Two more humans, so the DMs group lists four: each joins with a
-- welcome from Steve (ChitChat), and Ada writes to him too, so her DM comes
-- after Steve's own, which is always second (app/SidebarOrder.roc).
const MORE = {"Ada", "Cy"}
local more_cookies = {}
for name in MORE do
  local inv = post_form(base, steve, "/invites", {"name=" .. name})
  expect_status(inv, 200, "inviting " .. name)
  local c = re_find(inv.text, "/join#([A-Za-z0-9_-]+)")
  if c == nil then fail("screenshot: inviting " .. name .. " showed no /join# link") end
  local j = post_form(base, "none=1", "/join", {"code=" .. c.group, "name=" .. name, "password=" .. PASSWORD})
  expect_status(j, 303, name .. " joining")
  more_cookies[name] = cookie_of(j, name .. "'s join")
end
expect_status(post_form(base, more_cookies["Ada"], "/chat/dm/1_3", {"topic=hello"}), 303, "Ada's DM's topic")
expect_status(post_form(base, more_cookies["Ada"], "/chat/dm/1_3/hello", {"markdown=Hi Steve, is the sidebar quieter now?"}), 303, "Ada's message")

-- 2c. The channel card's members (app/ChannelRoster.roc): every human
-- joined #general, the default channel; Tam and then Ada post in it, so
-- they lead, Ada the latest; CC, Steve's agent, is added by the admin.
expect_status(post_form(base, tam, "/chat/channel/general/roc-chat", {"markdown=The channel card lists who's here now."}), 303, "Tam in #general")
expect_status(post_form(base, more_cookies["Ada"], "/chat/channel/general/roc-chat", {"markdown=And who spoke last."}), 303, "Ada in #general")
expect_status(post_form(base, steve, "/agents", {"name=CC"}), 303, "making CC")
expect_status(post_form(base, steve, "/channels/general/members/5/add", {"x=1"}), 303, "adding CC to #general")

-- A device of Steve's signed in by a code he makes: its session, for the
-- states that ask for it.
local made = post_form(base, steve, "/devices", {"none=1"})
expect_status(made, 303, "making a device code")
local device_code = re_find(made.text, "__Host-device_code=([0-9A-Z]+)")
if device_code == nil then fail("screenshot: making a device code set no code's cookie") end
local by_code = post_form(base, "none=1", "/login/code", {"code=" .. device_code.group})
expect_status(by_code, 303, "the device code's sign-in")
local sessions = {phone = cookie_of(by_code, "the device code's sign-in")}

-- 3. The shot list: Steve's cookie, then each theme's pages at each size,
-- then its states.
local list = {"base " .. base, "cookie " .. steve}
local names = {}
for t in themes do
  theme_steps(list, t)
  for s in sizes do
    push(list, "size " .. SIZES[s])
    for p in PAGES do
      local name = t .. "-" .. re_replace(SIZES[s], " ", "x") .. "-" .. p.name
      push(list, "goto " .. p.path)
      push(list, "shot " .. name)
      push(names, name)
    end
  end
  if with_states then
    for st in STATES do
      local size = SIZES[get(st, "size", "desktop")]
      local name = t .. "-" .. re_replace(size, " ", "x") .. "-" .. st.name
      push(list, "size " .. size)
      if has_key(st, "as") then push(list, "cookie " .. sessions[st.as]) end
      push(list, "goto " .. st.path)
      for step in st.steps do push(list, step) end
      push(list, "shot " .. name)
      if has_key(st, "as") then push(list, "cookie " .. steve) end
      push(names, name)
    end
  end
end
-- Cy, joined but never seen, is away until his first page, Browse, fetched
-- here by his session while Steve's DM holds its stream open; then Steve's
-- session again. Last, since he stays online.
if with_states then
  local size = SIZES[sizes[1]]
  local name = themes[#themes] .. "-" .. re_replace(size, " ", "x") .. "-dm-came-online"
  for step in {"size " .. size, "goto /chat/dm/1_2/plans",
      "eval new Promise(function (r) { setTimeout(r, 700); })",
      "cookie " .. more_cookies["Cy"], "eval fetch('/chat')", "cookie " .. steve,
      "wait .notice-strip a", "shot " .. name} do
    push(list, step)
  end
  push(names, name)
end
create(work .. "/shots.txt", join(list, "\n") .. "\n")

-- 4. The pictures, one browser for all of them.
local shot = must(run({"zig", "build", "run", "--", real(CHROME), real(work .. "/profile"), real(work .. "/shots.txt"), real(out)},
  {cwd = "tools/shot", timeout_ms = 110000, tail = 60, nice = 19, cpu_budget_ms = 16000, stage = "the pictures"}))
alone_on(port, server_pid)
for name in names do
  if not exists(out .. "/" .. name .. ".png") then fail("screenshot: " .. name .. ".png was not written\n" .. shot.out) end
end
job_stop(server)
remove_tree(work)
for l in re_lines(shot.out, "^shot ") do print(l.text) end
print("screenshot: " .. #names .. " PNGs in " .. out .. " (port " .. port .. ", " .. shot.ms .. " ms, " .. shot.cpu_ms .. " ms of CPU)")
