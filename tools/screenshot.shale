-- Screenshots of roc-chat's pages, so an agent can see what it changed.
-- It starts the chat on a throwaway data root seeded from the demo, signs
-- Steve in, invites Tam, writes a DM between them, invites Ada (who
-- writes to Steve) and Cy, and saves a PNG of each
-- page, in each theme, at a desktop's size and a phone's, and of what a
-- click or a key opens. Run it from roc-chat's root, naming the folder the
-- PNGs go to (made if missing):
--
--   shale tools/screenshot.shale out=build:shots/my-change
--
-- Each PNG is `<theme>-<width>x<height>-<name>.png`. The pages (PAGES,
-- below) are shot at 1280x800 and 390x844 (a phone), in dark (the app's
-- default) and light. What a click or a key opens is a state, one file
-- each in tools/shot-states/: `<name>.shot`, read in name order. A state
-- file starts with `#` lines that say what the picture shows, then its
-- settings, one `key = value` a line, then its steps, one a line, as
-- tools/shot/steps.zig reads them (`goto`, `click`, `key`, `type`, `wait`,
-- `eval`; `#` lines and blank lines are nothing). Its settings:
--   path = /chat/dm/1_2/plans  the page it starts on (required)
--   sizes = desktop,phone      the sizes it is shot at (required)
--   as = phone                 the session it is shot as, not Steve's
--   mutates = what it changes  it changes the server's data, so it runs
--                              after every picture that doesn't, each theme
--                              in turn, and no page shows another theme's
--                              data
--   after = <state>            it reads what that state made, so it runs
--                              right after it, with the states that mutate
--   last = yes                 it runs once, after everything, in the last
--                              theme: Cy, brought online, stays online
-- Two steps are this script's: `use <name>` puts the steps of
-- tools/shot-states/<name>.steps there, and `session <who>` sets the
-- cookie to steve's, phone's (a device Steve signed in by a code) or cy's.
--
-- `list=1` prints every page and state, what each shows, and how many
-- pictures a run takes, and starts nothing. `only=<name>[,<name>]` shoots
-- just those pages and states; `themes=dark` or `sizes=phone` (or
-- `desktop`) takes one alone; `states=0` leaves the states out.
--
-- Lanes run it at once, so each picks its own port: the first one free
-- (nothing listening, by `ss`) of PORTS, starting at a place its folder's
-- path picks; `port=` names one instead. The server takes its port with
-- SO_REUSEPORT, so a second server on a taken port starts without a word
-- and the two share its connections: once ours is up, the script stops
-- unless ours is the port's one listener, so it never posts to another
-- lane's chat.
--
-- The browser is Chrome for Testing's chrome-headless-shell, pinned under
-- Shale's `tools` mount (CHROME, below), driven by tools/shot/ (a small
-- Zig program, its own build apart from the server's) through the
-- DevTools protocol over a pipe: one browser for every picture, each step
-- of a list this script writes (tools/shot/steps.zig says the steps).
-- The session cookie and the theme (localStorage's `chat-theme`) are set
-- through the protocol, so no page of ours hands them over. Its sandbox
-- needs unprivileged user namespaces, which this box's AppArmor refuses,
-- so it runs with `--no-sandbox`, and it loads only this local chat.
--
-- Budgets: the pictures are held to CPU_MS_A_PICTURE of CPU each, and
-- CPU_MS_TO_START for the browser (about 0.15 s a picture on a busy box,
-- 2026-11-20), each picture's line printed as `shot <name> <ms>`; a full
-- run takes about 70 s of wall time once the server and the driver are
-- built. A `zig build` after the app changed adds about 25 s, the driver's
-- first build about 10 s.
-- The browser runs one renderer, its JavaScript heap capped at 128 MB,
-- under `nice`. The data root, the profile, the list and the logs are
-- under .zig-cache/screenshot.XXXXXX, removed at the end; a stop leaves
-- them, and its jobs (the server) end with it.

const CHROME = "tools:chrome-headless-shell-158.0.8127.36/chrome-headless-shell-linux64/chrome-headless-shell"
const PASSWORD = "correct horse battery staple"
const STATES_DIR = "tools/shot-states"
const CPU_MS_A_PICTURE = 160
const CPU_MS_TO_START = 2000
const WALL_MS_A_PICTURE = 1000
const WALL_MS_TO_START = 20000

local out = arg("out", "")
local listing = arg("list", 0) == 1
if out == "" and not listing then fail("screenshot: name the folder the PNGs go to, out=build:shots/<name>") end
local port_arg = arg("port", 0)
local themes_arg = arg("themes", "dark,light")
local sizes_arg = arg("sizes", "desktop,phone")
local with_states = arg("states", 1) == 1
local only_arg = arg("only", "")

const PAGES = {
  {name = "channel", path = "/chat/channel/general/roc-chat", about = "the demo's topic, with the keyboard help beside it at the desktop's size"},
  {name = "dm", path = "/chat/dm/1_2/plans", about = "Steve and Tam's DM"},
  {name = "recent", path = "/chat/recent", about = "Recent"},
  {name = "browse", path = "/chat", about = "Browse"},
  {name = "invites", path = "/invites", about = "the invites page"},
  {name = "devices", path = "/devices", about = "the \"Add a device\" page's steps"},
}
const SIZES = {desktop = "1280 800", phone = "390 844"}
-- The sessions a state may be shot as or switch to (`as`, `session`).
const SESSIONS = {"steve", "phone", "cy"}
-- The driver's verbs a state's steps may use; `size`, `cookie`, `base` and
-- `shot` are this script's to write.
const STATE_VERBS = {"goto", "click", "key", "type", "wait", "eval"}
const SETTINGS = {"path", "sizes", "as", "mutates", "after", "last"}

-- Where a port is looked for: 100 of them.
const PORTS_FROM = 9661
const PORTS = 100

-- A state's step, checked: a driver's verb or one of this script's.
function checked_step(line, where)
  local verb = words(line)[1]
  if verb == "use" or verb == "session" then
    if #words(line) ~= 2 then fail("screenshot: " .. where .. ": `" .. verb .. "` takes one word: " .. line) end
    if verb == "session" and not has_item(SESSIONS, words(line)[2]) then
      fail("screenshot: " .. where .. ": no session `" .. words(line)[2] .. "`; they are " .. join(SESSIONS, ", "))
    end
  elseif not has_item(STATE_VERBS, verb) then
    fail("screenshot: " .. where .. ": a state's step starts with one of " .. join(STATE_VERBS, ", ") .. ", use or session, not: " .. line)
  end
  return line
end

-- The steps of tools/shot-states/<name>.steps, for a `use`.
function used_steps(name, where)
  local file = STATES_DIR .. "/" .. name .. ".steps"
  if not exists(file) then fail("screenshot: " .. where .. ": no " .. file) end
  local steps = {}
  local n = 0
  for l in lines(read(file)) do
    n = n + 1
    local t = trim(l)
    if t ~= "" and not starts_with(t, "#") then
      if words(t)[1] == "use" then fail("screenshot: " .. file .. ":" .. n .. ": a `use` inside a .steps file") end
      push(steps, checked_step(t, file .. ":" .. n))
    end
  end
  return steps
end

-- A state file read and checked: `{name, about, path, sizes, as, mutates,
-- after, last, steps}`, `as` "steve" and `mutates` and `after` "" when unset.
function read_state(file)
  local base = basename(file)
  local st = {name = sub(base, 1, #base - 5), about = "", path = "", sizes = {}, as = "steve",
    mutates = "", after = "", last = false, steps = {}}
  local about = {}
  local at = "about"
  local seen = {}
  local n = 0
  for l in lines(read(file)) do
    n = n + 1
    local where = file .. ":" .. n
    local t = trim(l)
    local setting = re_find(t, "^([a-z]+) = (.+)$")
    if at == "about" and starts_with(t, "#") then
      push(about, trim(sub(t, 2, #t)))
    elseif n == 1 then
      fail("screenshot: " .. where .. ": a state file starts with a `#` line that says what it shows")
    elseif at ~= "steps" and setting ~= nil then
      at = "settings"
      local key = setting.groups[1]
      local value = setting.groups[2]
      if not has_item(SETTINGS, key) then fail("screenshot: " .. where .. ": no setting `" .. key .. "`; they are " .. join(SETTINGS, ", ")) end
      if has_key(seen, key) then fail("screenshot: " .. where .. ": `" .. key .. "` set twice") end
      seen[key] = true
      if key == "sizes" then
        for s in split(value, ",") do
          if not has_key(SIZES, s) then fail("screenshot: " .. where .. ": sizes are desktop and phone, not " .. s) end
          push(st.sizes, s)
        end
      elseif key == "last" then
        if value ~= "yes" then fail("screenshot: " .. where .. ": `last` is yes or unset") end
        st.last = true
      elseif key == "as" then
        if not has_item(SESSIONS, value) then fail("screenshot: " .. where .. ": no session `" .. value .. "`; they are " .. join(SESSIONS, ", ")) end
        st.as = value
      else
        st[key] = value
      end
    elseif t ~= "" and not starts_with(t, "#") then
      at = "steps"
      if words(t)[1] == "use" then
        for u in used_steps(words(t)[2], where) do push(st.steps, u) end
      else
        push(st.steps, checked_step(t, where))
      end
    end
  end
  if st.path == "" or not starts_with(st.path, "/") then fail("screenshot: " .. file .. ": `path = /...` names the page it starts on") end
  if #st.sizes == 0 then fail("screenshot: " .. file .. ": `sizes = desktop`, `phone` or `desktop,phone`") end
  st.about = join(about, " ")
  return st
end

-- Whether a state runs after every picture that changes nothing.
function late(st)
  return st.mutates ~= "" or st.after ~= "" or st.last
end

-- `st`, then the states `after` it, and those after them, onto `order`.
function push_with_followers(order, st, followers)
  push(order, st)
  if has_key(followers, st.name) then
    for f in followers[st.name] do push_with_followers(order, f, followers) end
  end
end

-- `states` in the order they run: those that change nothing by name, then
-- those that mutate by name, each followed by the states `after` it, then
-- the `last` ones.
function in_running_order(states)
  local early = {}
  local mutating = {}
  local lasts = {}
  local followers = {}
  local by_name = {}
  for st in states do by_name[st.name] = st end
  for st in states do
    if st.after ~= "" then
      if not has_key(by_name, st.after) then fail("screenshot: " .. st.name .. " is `after` " .. st.after .. ", which no state file names") end
      push_at(followers, st.after, st)
    elseif st.last then
      push(lasts, st)
    elseif st.mutates ~= "" then
      push(mutating, st)
    else
      push(early, st)
    end
  end
  local order = early
  for st in mutating do push_with_followers(order, st, followers) end
  for st in lasts do push_with_followers(order, st, followers) end
  if #order ~= #states then fail("screenshot: a state is `after` one that is itself after it, or after a state that changes nothing") end
  return order
end

-- The pids listening on TCP `at`, by `ss` (one line a socket).
function listeners(at)
  local r = must(run({"ss", "-Hltnp", "sport = :" .. at}, {timeout_ms = 5000, tail = 20}))
  local pids = {}
  for l in re_lines(r.out, ".") do
    local m = re_find(l.text, "pid=([0-9]+)")
    if m == nil then fail("screenshot: a listener on port " .. at .. " with no pid shown: " .. l.text) end
    push(pids, tonumber(m.group))
  end
  return pids
end

-- The first port of PORTS nothing listens on, from a place this checkout's
-- path picks, so two lanes seldom try the same one first.
function free_port()
  local path = real(".")
  local start = 0
  for i = 1, #path do
    local at = find("abcdefghijklmnopqrstuvwxyz0123456789-_./", sub(path, i, i))
    if at == nil then at = 0 end
    start = (start * 31 + at) % PORTS
  end
  for i = 0, PORTS - 1 do
    local at = PORTS_FROM + (start + i) % PORTS
    if #listeners(at) == 0 then return at end
  end
  fail("screenshot: no free port in " .. PORTS_FROM .. "-" .. (PORTS_FROM + PORTS - 1))
end

-- Stops the run unless `pid` is the one process listening on `at`.
function alone_on(at, pid)
  local listening = listeners(at)
  if #listening ~= 1 or listening[1] ~= pid then
    fail("screenshot: port " .. at .. " has listeners " .. join(listening, ",") .. ", not our server (" .. pid .. ") alone: another chat shares it, so its pages may be the other's; run again, or name a port with port=")
  end
end

-- A form POSTed as `cookie` (a `name=value`), each field's value
-- URL-encoded by curl: the answer's status, headers and body.
function post_form(base, cookie, path, fields)
  local argv = {"curl", "-s", "-D", "-", "-H", "Cookie: " .. cookie}
  for f in fields do
    push(argv, "--data-urlencode")
    push(argv, f)
  end
  push(argv, base .. path)
  local r = must(run(argv, {timeout_ms = 10000, whole = 200000}))
  local status = re_find(r.out, "^HTTP/1\\.1 ([0-9]+)")
  if status == nil then fail("screenshot: POST " .. path .. " gave no status: " .. sub(r.out, 1, 200)) end
  return {status = tonumber(status.group), text = r.out}
end

-- The session cookie a 303's `Set-Cookie` sets, as `name=value`.
function cookie_of(answer, what)
  local c = re_find(answer.text, "(?:^|\n)[Ss]et-[Cc]ookie: (__Host-gopher_auth=[^;\r\n]+)")
  if c == nil then fail("screenshot: " .. what .. " set no session cookie (" .. answer.status .. ")") end
  return c.group
end

function expect_status(answer, want, what)
  if answer.status ~= want then fail("screenshot: " .. what .. ": " .. answer.status .. ", not " .. want .. "\n" .. sub(answer.text, 1, 400)) end
end

-- The steps that make `theme` the page's: localStorage, which belongs to
-- the chat's origin, so a page of it is loaded first.
function theme_steps(list, theme)
  push(list, "goto /chat")
  if theme == "light" then
    push(list, "eval localStorage.setItem('chat-theme', 'light')")
  else
    push(list, "eval localStorage.removeItem('chat-theme')")
  end
end

-- A picture's PNG name.
function picture_name(theme, size, name)
  return theme .. "-" .. re_replace(SIZES[size], " ", "x") .. "-" .. name
end

-- The sizes of `wanted` that `sizes` holds, in `wanted`'s order.
function sizes_of(wanted, sizes)
  local kept = {}
  for s in wanted do
    if has_item(sizes, s) then push(kept, s) end
  end
  return kept
end

const themes = split(themes_arg, ",")
const sizes = split(sizes_arg, ",")
for t in themes do
  if t ~= "dark" and t ~= "light" then fail("screenshot: themes= takes dark and light, not " .. t) end
end
for s in sizes do
  if not has_key(SIZES, s) then fail("screenshot: sizes= takes desktop and phone, not " .. s) end
end

-- The states, read and checked before anything starts.
local all_states = {}
for file in glob(STATES_DIR .. "/*.shot") do push(all_states, read_state(file)) end
sort(all_states, "name")
for st in all_states do
  for p in PAGES do
    if p.name == st.name then fail("screenshot: " .. st.name .. " is a page's name and a state's") end
  end
end
all_states = in_running_order(all_states)

-- What this run shoots: every page and state, or those `only=` names.
local pages = PAGES
local states = all_states
if not with_states then states = {} end
if only_arg ~= "" then
  local only = split(only_arg, ",")
  pages = {}
  states = {}
  local known = {}
  for p in PAGES do
    if has_item(only, p.name) then push(pages, p) end
    push(known, p.name)
  end
  for st in all_states do
    if has_item(only, st.name) then push(states, st) end
    push(known, st.name)
  end
  for name in only do
    if not has_item(known, name) then fail("screenshot: only= names " .. name .. ", which is no page or state (list=1 lists them)") end
  end
  for st in states do
    if st.after ~= "" and not has_item(only, st.after) then fail("screenshot: " .. st.name .. " reads what " .. st.after .. " makes; name both in only=") end
  end
end

-- The pictures in the order they are taken: `{theme, size, page}` or
-- `{theme, size, state}`. Each theme's pages and the states that change
-- nothing, then each state that mutates in every theme, then the last.
local plan = {}
for t in themes do
  for s in sizes do
    for p in pages do push(plan, {theme = t, size = s, page = p}) end
  end
  for st in states do
    if not late(st) then
      for s in sizes_of(st.sizes, sizes) do push(plan, {theme = t, size = s, state = st}) end
    end
  end
end
-- A state another one is `after` runs for its data even when `sizes=`
-- leaves out each of its sizes: then at its first.
local needed = {}
for st in states do
  if st.after ~= "" then needed[st.after] = true end
end
for st in states do
  if late(st) then
    local its_themes = themes
    if st.last then its_themes = {themes[#themes]} end
    local its_sizes = sizes_of(st.sizes, sizes)
    if #its_sizes == 0 and has_key(needed, st.name) then its_sizes = {st.sizes[1]} end
    for t in its_themes do
      for s in its_sizes do push(plan, {theme = t, size = s, state = st}) end
    end
  end
end

if listing then
  local rows = {}
  for p in PAGES do push(rows, {name = p.name, sizes = "desktop,phone", runs = "page", about = p.path .. ": " .. p.about}) end
  for st in all_states do
    local runs = "state"
    if st.last then runs = "last" elseif st.after ~= "" then runs = "after " .. st.after elseif st.mutates ~= "" then runs = "mutates" end
    local about = st.path .. ": " .. st.about
    if st.mutates ~= "" then about = about .. " (" .. st.mutates .. ")" end
    push(rows, {name = st.name, sizes = join(st.sizes, ","), runs = runs, about = about})
  end
  print(table(rows, {"name", "sizes", "runs", "about"}))
  print("screenshot: " .. #plan .. " pictures in " .. join(themes, ",") .. " at " .. join(sizes, ","))
  return
end

if not exists(CHROME) then fail("screenshot: no browser at " .. CHROME .. "; Chrome for Testing's chrome-headless-shell, that version, unzipped there") end

-- 0. The server and the driver, built niced, so the job below starts at once.
must(run({"zig", "build"}, {timeout_ms = 600000, tail = 20, nice = 19}))
must(run({"zig", "build", "install"}, {cwd = "tools/shot", timeout_ms = 300000, tail = 20, nice = 19}))

local work = fresh_dir(".zig-cache", "screenshot")
local data = work .. "/data"
mkdir(work .. "/profile")
mkdir(out)

-- 1. The chat, on the demo's topic; its first start makes Steve.
local port = port_arg
if port == 0 then port = free_port() end
mkdir(data)
copy("demo/data/chat", data .. "/chat")
local base = "http://localhost:" .. port
local server = job_start({"zig", "build", "serve", "--", real(data), "--port", "" .. port}, {log = work .. "/server.log"})
local up = job_wait(server, {timeout_ms = 60000, contains = "roc-chat: http://"})
if up.ended ~= "found" then fail("screenshot: the server did not start (" .. up.ended .. "); see " .. work .. "/server.log") end
-- Ours is the one process serving this data root, and it must be the
-- port's one listener, now and once the pictures are taken.
local ours = {}
for p in procs() do
  if p.name == "roc-chat" and find(p.args, real(data)) ~= nil then push(ours, p.pid) end
end
if #ours ~= 1 then fail("screenshot: " .. #ours .. " processes serve " .. data .. ", not 1") end
const server_pid = ours[1]
alone_on(port, server_pid)

local hashed = must(run({"zig", "build", "serve", "--", "hash-password"}, {stdin = PASSWORD .. "\n", timeout_ms = 60000, tail = 3}))
create(data .. "/auth/1/password", trim(hashed.out) .. "\n")
local steve = cookie_of(post_form(base, "none=1", "/login", {"name=Steve", "password=" .. PASSWORD, "next=/chat"}), "Steve's sign-in")

-- 2. Tam, invited and joined, and a DM between them.
local invited = post_form(base, steve, "/invites", {"name=Tam"})
expect_status(invited, 200, "inviting Tam")
local code = re_find(invited.text, "/join#([A-Za-z0-9_-]+)")
if code == nil then fail("screenshot: inviting Tam showed no /join# link") end
local joined = post_form(base, "none=1", "/join", {"code=" .. code.group, "name=Tam", "password=" .. PASSWORD})
expect_status(joined, 303, "Tam joining")
local tam = cookie_of(joined, "Tam's join")

expect_status(post_form(base, steve, "/chat/dm/1_2", {"topic=plans"}), 303, "the DM's topic")
const DM = {
  {who = "steve", text = "Shall we meet **Thursday**? I can bring the draft of `docs/design.md`."},
  {who = "tam", text = "Thursday works. Two things first:\n\n- the sidebar on a phone\n- the person card's DM list"},
  {who = "steve", text = "Good. Here's the check I run:\n\n```shale\nshale tools/screenshot.shale out=build:shots/thursday\n```"},
  {who = "tam", text = "> the sidebar on a phone\n\nI'll look at that one tonight."},
}
for m in DM do
  local who = steve
  if m.who == "tam" then who = tam end
  expect_status(post_form(base, who, "/chat/dm/1_2/plans", {"markdown=" .. m.text}), 303, "a DM message")
end

-- Steve's own DM, a topic with a note, for `l` there.
expect_status(post_form(base, steve, "/chat/dm/1_1", {"topic=notes"}), 303, "Steve's own DM's topic")
expect_status(post_form(base, steve, "/chat/dm/1_1/notes", {"markdown=A note to **myself**."}), 303, "a note to self")

-- 2b. Two more humans, so the DMs group lists four: each joins with a
-- welcome from Steve (ChitChat), and Ada writes to him too, so her DM comes
-- after Steve's own, which is always second (app/SidebarOrder.roc).
const MORE = {"Ada", "Cy"}
local more_cookies = {}
for name in MORE do
  local inv = post_form(base, steve, "/invites", {"name=" .. name})
  expect_status(inv, 200, "inviting " .. name)
  local c = re_find(inv.text, "/join#([A-Za-z0-9_-]+)")
  if c == nil then fail("screenshot: inviting " .. name .. " showed no /join# link") end
  local j = post_form(base, "none=1", "/join", {"code=" .. c.group, "name=" .. name, "password=" .. PASSWORD})
  expect_status(j, 303, name .. " joining")
  more_cookies[name] = cookie_of(j, name .. "'s join")
end
expect_status(post_form(base, more_cookies["Ada"], "/chat/dm/1_3", {"topic=hello"}), 303, "Ada's DM's topic")
expect_status(post_form(base, more_cookies["Ada"], "/chat/dm/1_3/hello", {"markdown=Hi Steve, is the sidebar quieter now?"}), 303, "Ada's message")

-- 2c. The channel card's members (app/ChannelRoster.roc): every human
-- joined #general, the default channel; Tam and then Ada post in it, so
-- they lead, Ada the latest; CC, Steve's agent, is added by the admin.
expect_status(post_form(base, tam, "/chat/channel/general/roc-chat", {"markdown=The channel card lists who's here now."}), 303, "Tam in #general")
expect_status(post_form(base, more_cookies["Ada"], "/chat/channel/general/roc-chat", {"markdown=And who spoke last."}), 303, "Ada in #general")
expect_status(post_form(base, steve, "/agents", {"name=CC"}), 303, "making CC")
expect_status(post_form(base, steve, "/channels/general/members/5/add", {"x=1"}), 303, "adding CC to #general")

-- A device of Steve's signed in by a code he makes: its session, for the
-- states that ask for it.
local made = post_form(base, steve, "/devices", {"none=1"})
expect_status(made, 303, "making a device code")
local device_code = re_find(made.text, "__Host-device_code=([0-9A-Z]+)")
if device_code == nil then fail("screenshot: making a device code set no code's cookie") end
local by_code = post_form(base, "none=1", "/login/code", {"code=" .. device_code.group})
expect_status(by_code, 303, "the device code's sign-in")
local sessions = {steve = steve, phone = cookie_of(by_code, "the device code's sign-in"), cy = more_cookies["Cy"]}

-- 3. The shot list: Steve's cookie, then the plan's pictures, each theme
-- set as the plan comes to it, each state's steps with its `session`s'
-- cookies.
local list = {"base " .. base, "cookie " .. steve}
local names = {}
local theme_now = ""
local size_now = ""
for pic in plan do
  if pic.theme ~= theme_now then
    theme_steps(list, pic.theme)
    theme_now = pic.theme
    size_now = ""
  end
  if has_key(pic, "state") or pic.size ~= size_now then
    push(list, "size " .. SIZES[pic.size])
    size_now = pic.size
  end
  local name = ""
  if has_key(pic, "page") then
    name = picture_name(pic.theme, pic.size, pic.page.name)
    push(list, "goto " .. pic.page.path)
  else
    local st = pic.state
    name = picture_name(pic.theme, pic.size, st.name)
    if st.as ~= "steve" then push(list, "cookie " .. sessions[st.as]) end
    push(list, "goto " .. st.path)
    for step in st.steps do
      if words(step)[1] == "session" then
        push(list, "cookie " .. sessions[words(step)[2]])
      else
        push(list, step)
      end
    end
  end
  push(list, "shot " .. name)
  if has_key(pic, "state") and pic.state.as ~= "steve" then push(list, "cookie " .. steve) end
  push(names, name)
end
create(work .. "/shots.txt", join(list, "\n") .. "\n")

-- 4. The pictures, one browser for all of them.
local shot = must(run({"zig", "build", "run", "--", real(CHROME), real(work .. "/profile"), real(work .. "/shots.txt"), real(out)},
  {cwd = "tools/shot", timeout_ms = WALL_MS_TO_START + WALL_MS_A_PICTURE * #names, tail = 60 + #names, nice = 19,
    cpu_budget_ms = CPU_MS_TO_START + CPU_MS_A_PICTURE * #names, stage = "the pictures"}))
alone_on(port, server_pid)
for name in names do
  if not exists(out .. "/" .. name .. ".png") then fail("screenshot: " .. name .. ".png was not written\n" .. shot.out) end
end
job_stop(server)
remove_tree(work)
for l in re_lines(shot.out, "^shot ") do print(l.text) end
print("screenshot: " .. #names .. " PNGs in " .. out .. " (port " .. port .. ", " .. shot.ms .. " ms, " .. shot.cpu_ms .. " ms of CPU)")
