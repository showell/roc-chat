-- **THE STYLE HUNTS, HELD AT ZERO, AND THE FORMATTERS**: verify's hunts
-- and its two `fmt --check`s, in a run of their own. tools/verify.shale
-- runs it, from the repository's root:
--
--   shale tools/verify_hunts.shale
--
-- It prints one line a check, `PASS` or `FAIL`, which verify reads back
-- into its own checklist, and exits 0 only when every line passed.
--
-- Shale's cookbook recipes over app/ (roc-apps docs/roc-style.md, "Testing
-- and enforcement"), read from roc-ast's tree: each count named here reads
-- zero (each recipe's `self_test=1`, Shale's, proves it finds what it
-- hunts). What stands beside them (nest_depth at three deep, stack's long
-- lines, name_hunt's other checks) is a question for a reader, not a gate.
--
-- budget: steps=200000000 arena_bytes=1000000000 changes=1000 change_bytes=50000000 read_bytes=500000000

const board = {failed = 0}

function say(ok, what)
  local mark = "FAIL"
  if ok then mark = "PASS" end
  if not ok then board.failed = board.failed + 1 end
  print(mark .. "  " .. what)
end

const hunts = {
  {recipe = "boundaries", args = {}, counts = {"fixed ([0-9]+)"}},
  {recipe = "errors", args = {}, counts = {"error_alias ([0-9]+)", "optional_tag ([0-9]+)"}},
  {recipe = "nest_depth", args = {"min=4"}, counts = {"nested ([0-9]+)"}},
  {recipe = "name_hunt", args = {}, counts = {"state_effect ([0-9]+)", "question ([0-9]+)", "negative ([0-9]+)", "command_tense ([0-9]+)", "mixed_tense ([0-9]+)", "container ([0-9]+)"}},
  {recipe = "stack", args = {}, counts = {"([0-9]+) to stack"}},
}

-- A recipe run over app/: its summary, its last line, and each of
-- `counts` read from it (nil where the summary does not say it, as when
-- the recipe stopped).
function hunt_run(h)
  local argv = {"shale", real("cookbook:roc/" .. h.recipe .. ".shale"), "glob=app/**/*.roc"}
  for a in h.args do push(argv, a) end
  local r = run(argv, {cwd = ".", timeout_ms = 600000, tail = 40})
  -- The recipe's summary is its last line of its own: a Shale run that
  -- took over a second ends with `── time:` (and its budget) footers,
  -- which a busy box makes come and go.
  local said = lines(trim(r.out))
  local last = ""
  for l in said do
    if not starts_with(l, "──") and trim(l) ~= "" then last = l end
  end
  local got = {}
  for c in h.counts do
    local m = re_find(last, c)
    if m ~= nil and r.code == 0 then push(got, {pattern = c, n = tonumber(m.groups[1])}) end
  end
  return {last = last, got = got, code = r.code}
end

for h in hunts do
  local r = hunt_run(h)
  local zero = #r.got == #h.counts
  for g in r.got do
    if g.n ~= 0 then zero = false end
  end
  say(zero, "hunt " .. h.recipe .. (#h.args > 0 and (" " .. join(h.args, " ")) or "") .. ": " .. r.last)
end

-- ── the formatters ──
const roc = real("tools:roc-" .. trim(read("roc-version")) .. "/roc")
local zf = run({"zig", "fmt", "--check", "host", "build.zig"}, {cwd = ".", timeout_ms = 60000, tail = 20})
say(zf.code == 0, "zig fmt --check host build.zig" .. (zf.code == 0 and "" or (": " .. trim(zf.out))))
local rf = run({roc, "fmt", "--check", "app", "platform"}, {cwd = ".", timeout_ms = 60000, tail = 20})
say(rf.code == 0, "roc fmt --check app platform" .. (rf.code == 0 and "" or (": " .. trim(rf.out))))

if board.failed > 0 then fail("verify_hunts: " .. board.failed .. " failed") end
