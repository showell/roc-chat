# Someone invited by the form: the link's card, the form behind "Invite
# someone else", and the address /invites, not the POST's, so a reload
# makes no invite. (Each theme invites a new name, as every human the run
# makes has joined, so none has a "New link" button.)
path = /invites
sizes = desktop
mutates = makes an invite for a new name
click input[name=name]
eval document.querySelector('input[name=name]').value = 'Guest ' + Array.from({length: 6}, () => 'abcdefghijklmnopqrstuvwxyz'[Math.floor(Math.random() * 26)]).join('')
click form[action="/invites"] button
wait .invite-made
eval if (location.pathname === '/invites') document.body.setAttribute('data-at-invites', '')
wait body[data-at-invites]
