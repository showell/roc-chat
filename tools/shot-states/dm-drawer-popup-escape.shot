# A phone's drawer open, Tam's card opened from it, then Escape: the card
# closed and the drawer still open; the drawer closes on the next press.
path = /chat/dm/1_2/plans
sizes = phone
click .sidebar-toggle
wait .sidebar-toggle[aria-expanded=true]
eval new Promise(function (r) { setTimeout(r, 400); })
click .sidebar-place[data-section="/chat/dm/1_2"] .sidebar-place-name
wait dialog.place-popup[open]
key Escape
eval new Promise(function (ok, no) { var t = Date.now(); (function look() { if (!document.querySelector('dialog.place-popup')) return document.querySelector('.sidebar-toggle[aria-expanded=true]') ? ok(true) : no(new Error('Escape closed the drawer with the card')); if (Date.now() - t > 2000) return no(new Error('Escape left the card open')); setTimeout(look, 50); })(); })
