# A Recent tile, a card that happens to be a link, drags nowhere: a
# dragstart on the newest tile is cancelled (app/palette.js). These keep
# their drag: the tile's text (a selection's drag starts on its Text node),
# an element marked draggable="true", a top-bar link, and on a conversation
# a message's reference link, a plain link and an image in a message's body
# (the last two put there by the step, as the demo's messages hold none).
# Each `eval` throws, stopping the run, when one goes the other way; the
# picture is the conversation as it was, nothing moved.
path = /chat/recent
sizes = desktop,phone
wait .recent-list .recent-tile
eval (function () { function drag(node) { var e = new DragEvent('dragstart', {bubbles: true, cancelable: true}); node.dispatchEvent(e); return e.defaultPrevented; } var tile = document.querySelector('.recent-tile'); if (!drag(tile)) throw new Error('a Recent tile still drags'); var text = document.createTreeWalker(tile, NodeFilter.SHOW_TEXT).nextNode(); if (!text || drag(text)) throw new Error('a drag of a tile\'s text was cancelled'); var marked = document.createElement('span'); marked.setAttribute('draggable', 'true'); tile.appendChild(marked); var kept = !drag(marked); marked.remove(); if (!kept) throw new Error('a draggable="true" element lost its drag'); var top = document.querySelector('.top-links a[href]'); if (!top || drag(top)) throw new Error('a top-bar link lost its drag'); })()
goto /chat/channel/general/roc-chat
wait .message .body
eval (function () { function drag(node) { var e = new DragEvent('dragstart', {bubbles: true, cancelable: true}); node.dispatchEvent(e); return e.defaultPrevented; } var ref = document.querySelector('.message a.message-reference'); if (!ref || drag(ref)) throw new Error('a message reference link lost its drag'); var body = document.querySelector('.message .body'); var link = document.createElement('a'); link.href = 'https://example.com/'; link.textContent = 'a link'; var img = document.createElement('img'); img.alt = ''; body.appendChild(link); body.appendChild(img); var linkKept = !drag(link), imgKept = !drag(img); link.remove(); img.remove(); if (!linkKept) throw new Error('a link in a message lost its drag'); if (!imgKept) throw new Error('an image in a message lost its drag'); })()
