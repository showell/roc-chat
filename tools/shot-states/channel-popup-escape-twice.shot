# As channel-popup-escape, then Escape again: the empty box closed, to
# the green "Open compose box" button.
path = /chat/channel/general/roc-chat
sizes = desktop,phone
key c
wait .compose.open
click .search-open
wait dialog.search-dialog[open]
key Escape
eval new Promise(function (ok, no) { var t = Date.now(); (function look() { if (!document.querySelector('dialog.search-dialog')) return document.querySelector('.compose.open') ? ok(true) : no(new Error('Escape closed the box with the dialog')); if (Date.now() - t > 2000) return no(new Error('Escape left the search dialog open')); setTimeout(look, 50); })(); })
key Escape
wait .compose:not(.open)
