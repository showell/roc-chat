# Home, then `l`, on #general: the citation of the first message the
# clipboard gets, its text shown over the messages, the "copied" notice,
# and the compose box's placeholder, which names the place too.
path = /chat/channel/general/roc-chat
sizes = desktop
wait .compose textarea[placeholder="Message #general › roc-chat"]
key Home
wait #msg-1.selected
use capture-clipboard
key l
wait #cite-seen[data-text$=" in #general › roc-chat](/chat/channel/general/roc-chat#msg-1)\A"]
wait .cite-notice
