# Home, then `l`, on Steve's own DM (its topic `notes`): the citation of
# the first message the clipboard gets, its text shown over the messages,
# the "copied" notice, and the compose box's placeholder, which names the
# place too.
path = /chat/dm/1_1/notes
sizes = desktop
wait .compose textarea[placeholder="Message Steve"]
key Home
wait #msg-1.selected
use capture-clipboard
key l
wait #cite-seen[data-text$="\A\A[Steve in Steve › notes](/chat/dm/1_1/notes#msg-1)\A"]
wait .cite-notice
