# The clipboard, as `l` writes a citation to it: the text shown on the
# page, and held in its data-text for a `wait` to read.
eval window.ClipboardItem = undefined; Object.defineProperty(navigator, 'clipboard', {configurable: true, value: {writeText: function (t) { var p = document.createElement('pre'); p.id = 'cite-seen'; p.textContent = t; p.setAttribute('data-text', t); p.style.cssText = 'position:fixed;top:60px;left:280px;z-index:99;background:#fff;color:#000;padding:8px;white-space:pre-wrap;max-width:700px;font-size:14px'; document.body.appendChild(p); return Promise.resolve(); }}})
