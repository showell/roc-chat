-- This hunt holds roc-chat to one rule: no human sets, resets or takes over
-- another human's credentials. Run it from roc-chat's root;
-- tools/verify.shale runs it among its hunts.
--
--   shale tools/check_credential_writers.shale
--
-- Whether a proof is the account's own is a reading of the code, not a
-- fact a script can find, so the hunt makes every path to a credential a
-- line of tools/credential_writers.txt, where a reader judges it once, and
-- fails on any path that file doesn't name:
--
--   - Every function of app/*.roc (but the `*Spec.roc`s) that writes a file
--     (`FileFacts`' create_fact!, replace_fact!, create_facts!,
--     append_to_file!, create_binary_file!) is a `writes` line, saying
--     whether it writes a `credential` (a password's hash, a GitHub link, a
--     session's secret or generation, a key, a code or an invite that
--     redeems to one) or an `other` file, and why.
--   - Every call of a `credential` function, from any function of app/*.roc
--     (but the Specs), is a `calls` line naming the caller and the proof
--     that guards it, one of `proofs` below. A caller that only passes the
--     write on (`issue_invite!`) is a `writes` line too, marked
--     `credential`, so its own callers are judged in turn.
--   - A line that names a function or a call the code no longer has is
--     stale.
--
-- The proofs that are the account's own: `own-session` (a full session of
-- that human, not a device code's), `own-github` (GitHub answered the id the
-- account holds, or one no account holds, for a new one), `own-code` (a
-- code made for that account alone, by its own session or for its first
-- join, before it holds any credential), `new-account` (the account is
-- being made, so holds nothing to take), `agent-keeper` (an agent's
-- credentials, by the human who keeps it: an agent is no human), and
-- `revokes` (it only ends or spends a credential). `passes-on` is no
-- proof but a hand-off, allowed only to a caller that is a `credential`
-- `writes` line itself, so its callers are judged. Any other proof is no
-- proof of the account's own, `not_own`: today `inviter`, the invite again
-- that sets a joined human's password (docs/design.md, "Sign-in"), which
-- tools/verify.shale holds at exactly 1 until the owner decides it.
--
-- A function is the nearest line above that defines one (`name! = `, at
-- most two tabs in), so a function's own effects are judged by its name;
-- a comment line is never a call. It prints one line a finding,
-- `path:line: credential-writers: why`, and last its summary:
-- `credential-writers: unlisted N, stale N, not_own N`.
--
-- budget: steps=30000000

const TABLE = "tools/credential_writers.txt"
const OWN = {"own-session", "own-github", "own-code", "new-account", "agent-keeper", "revokes"}
const NOT_OWN = {"inviter"}
const WRITE = "FileFacts\\.(create_fact|replace_fact|create_facts|append_to_file|create_binary_file)!\\("
const DEFINES = "^\t{0,2}([a-z][a-z0-9_]*!) = "

const board = {unlisted = 0, stale = 0, not_own = 0}
-- Each credential writer some code calls, judged or not.
const called_in_code = {}

function finding(kind, at, why)
  board[kind] = board[kind] + 1
  print(at .. ": credential-writers: " .. why)
end

-- The table: `writes <Module.fn> credential|other <why>` and
-- `calls <Writer.fn> <Caller.fn> <proof> <why>`.
const writes = {}
const calls = {}
local n = 0
for l in lines(read(TABLE)) do
  n = n + 1
  local w = words(l)
  if #w > 0 and not starts_with(trim(l), "#") then
    local at = TABLE .. ":" .. n
    if w[1] == "writes" and #w >= 4 and (w[3] == "credential" or w[3] == "other") then
      writes[w[2]] = {kind = w[3], at = at, seen = false}
    elseif w[1] == "calls" and #w >= 5 then
      if not has_item(OWN, w[4]) and not has_item(NOT_OWN, w[4]) and w[4] ~= "passes-on" then fail(at .. ": no such proof: " .. w[4]) end
      calls[w[2] .. " " .. w[3]] = {proof = w[4], at = at, seen = false}
    else
      fail(at .. ": not a `writes` or a `calls` line: " .. l)
    end
  end
end

-- Each module's functions that write, and each call of a credential
-- function, with the function it is in.
function module_of(path)
  local name = basename(path)
  return sub(name, 1, #name - 4)
end

function scan(path, credential_names)
  local module = module_of(path)
  local current = nil
  local i = 0
  for l in lines(read(path)) do
    i = i + 1
    local d = re_find(l, DEFINES)
    if d ~= nil then current = module .. "." .. d.group end
    local code = not starts_with(trim(l), "#")
    if code and re_find(l, WRITE) ~= nil then
      local at = path .. ":" .. i
      if current == nil then
        finding("unlisted", at, "a write outside any function")
      elseif not has_key(writes, current) then
        finding("unlisted", at, current .. " writes a file and is no `writes` line of " .. TABLE)
      else
        writes[current].seen = true
      end
    end
    if code and find(l, "!(") ~= nil then
      for c in credential_names do
        local w = c.full
        local called = find(l, w .. "(") ~= nil
        -- Its own module may call it bare; its definition is no call.
        if not called and c.module == module and re_find(l, "(^|[^a-z0-9_.])" .. c.name .. "\\(") ~= nil then called = true end
        if called then
          called_in_code[w] = true
          local at = path .. ":" .. i
          local key = w .. " " .. (current or "?")
          if not has_key(calls, key) then
            finding("unlisted", at, (current or "a top-level line") .. " calls the credential writer " .. w .. ", and no `calls` line names it")
          else
            calls[key].seen = true
          end
        end
      end
    end
  end
end

const credential_names = {}
for k in keys(writes) do
  if writes[k].kind == "credential" then
    local dot = find(k, ".")
    push(credential_names, {full = k, module = sub(k, 1, dot - 1), name = sub(k, dot + 1)})
  end
end

for p in glob("app/*.roc") do
  if not ends_with(p, "Spec.roc") then scan(p, credential_names) end
  yield()
end

for k in keys(writes) do
  if not writes[k].seen and writes[k].kind == "other" then finding("stale", writes[k].at, k .. " writes no file now") end
end
for k in keys(calls) do
  local c = calls[k]
  if not c.seen then
    finding("stale", c.at, "no such call now: " .. k)
  elseif has_item(NOT_OWN, c.proof) then
    finding("not_own", c.at, k .. ": its proof, `" .. c.proof .. "`, is not the account's own")
  elseif c.proof == "passes-on" then
    local caller = words(k)[2]
    if not has_key(writes, caller) or writes[caller].kind ~= "credential" then
      finding("unlisted", c.at, k .. ": `passes-on`, but " .. caller .. " is no `credential` writes line, so nothing judges its callers")
    end
  end
end
for k in keys(writes) do
  -- A credential writer no code calls is stale too, unless it writes itself.
  if writes[k].kind == "credential" and not writes[k].seen and not has_key(called_in_code, k) then
    finding("stale", writes[k].at, k .. " writes no file and nothing calls it")
  end
end

print("credential-writers: unlisted " .. board.unlisted .. ", stale " .. board.stale .. ", not_own " .. board.not_own)
if board.unlisted + board.stale > 0 then fail("credential-writers: " .. (board.unlisted + board.stale) .. " findings") end
