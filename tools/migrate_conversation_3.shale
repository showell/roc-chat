-- **CONVERSATION 3 BECOMES RocChatDev/initial-work** (Steve, 2026-11-01):
-- the conversation of Steve, LC and Cloud moves to a channel, RocChatDev,
-- whose members are its three participants, and a topic in it,
-- initial-work, which holds its history. Run once, from roc-chat's root,
-- after a deploy whose channels take agents as members:
--
--   shale tools/migrate_conversation_3.shale
--
-- No arguments. Over ssh, as the deploy works, each step refusing by name
-- what it cannot do:
-- 1. Reads conversation 3's record and takes its participants as they are
--    bound (`with=`, the spelling a channel's `members=` uses), refusing
--    any that is not three, Steve's (human:1) among them.
-- 2. Refuses when the channel's folder is there already: it never writes
--    over a channel.
-- 3. Copies the transcript, its offsets and its tally into the topic's
--    folder (a topic's files are a conversation's, line for line: a message
--    names no conversation), then writes the topic's record, then the
--    channel's, last, so the server, which reads the disk on every request,
--    never sees a topic without its history.
-- 4. Proves each copy is its source, byte for byte.
--
-- Conversation 3 is left as it is, for the wipe before launch. The
-- channel's making is the script's, not an admin's form, so the audit log
-- has no line for it.
--
-- budget: steps=5000000

const HOST = "steve@162.243.1.123"
const DATA = "/var/lib/roc-chat/data"
const CONV = DATA .. "/chat/conversations/3"
const CHANNEL = DATA .. "/chat/channels/rocchatdev"
const TOPIC = CHANNEL .. "/topics/initial-work"
const PAGE = "https://chat.lynrummy.com/chat/channel/RocChatDev/initial-work"

if not exists("deploy/config.zon") then fail("migrate: run it from roc-chat's root") end

-- A command on prod: it must succeed.
function on_prod(script)
  return must(run({"ssh", HOST, script}, {timeout_ms = 60000, whole = 100000, want = "ssh: the migration's steps on prod"}))
end

-- A command on prod whose exit is an answer: 0 yes, 1 no.
function asks_prod(script)
  local r = run({"ssh", HOST, script}, {timeout_ms = 60000, whole = 100000, want = "ssh: a question to prod, its exit the answer"})
  if r.code ~= 0 and r.code ~= 1 then fail("migrate: prod could not be asked (ssh exit " .. r.code .. "): " .. trim(r.out)) end
  return r.code == 0
end

-- Whether `text` is a binding as AccountCodec spells one: `<kind>:<n>/<g>/<g>`.
function is_binding(text)
  local colon = find(text, ":")
  if colon == nil then return false end
  local kind = sub(text, 1, colon - 1)
  if kind ~= "human" and kind ~= "agent" and kind ~= "bot" then return false end
  local parts = split(sub(text, colon + 1, #text), "/")
  if #parts ~= 3 then return false end
  for part in parts do
    if part == "" then return false end
    for i = 1, #part do
      local c = sub(part, i, i)
      if c < "0" or c > "9" then return false end
    end
  end
  return true
end

-- 1. Conversation 3, and who is in it.
if not asks_prod("sudo test -s " .. CONV) then fail("migrate: " .. CONV .. " is not on prod") end
for folder in {"transcripts", "offsets", "tallies"} do
  if not asks_prod("sudo test -s " .. DATA .. "/chat/" .. folder .. "/3") then fail("migrate: " .. DATA .. "/chat/" .. folder .. "/3 is missing or empty on prod") end
end
local record = trim(on_prod("sudo cat " .. CONV).out)
if not starts_with(record, "conversation v1 id=3 ") then fail("migrate: conversation 3's record does not read: " .. record) end
local at = find(record, " with=")
if at == nil then fail("migrate: conversation 3's record names no one: " .. record) end
local rest = sub(record, at + 6, #record)
local space = find(rest, " ")
local members = rest
if space ~= nil then members = sub(rest, 1, space - 1) end
local bound = split(members, ",")
if #bound ~= 3 then fail("migrate: conversation 3 has " .. #bound .. " participants, not three: " .. members) end
local has_steve = false
for b in bound do
  if not is_binding(b) then fail("migrate: '" .. b .. "' is no binding, in " .. members) end
  if starts_with(b, "human:1/") then has_steve = true end
end
if not has_steve then fail("migrate: Steve (human:1) is not among conversation 3's participants: " .. members) end
print("conversation 3's participants: " .. members)

-- 2. Never over a channel.
if asks_prod("sudo test -e " .. CHANNEL) then fail("migrate: " .. CHANNEL .. " is there already; nothing was changed") end

-- 3. The history first, then the topic, then the channel.
on_prod("set -e\n"
  .. "sudo -u rocchat mkdir -p " .. TOPIC .. "\n"
  .. "sudo -u rocchat cp " .. DATA .. "/chat/transcripts/3 " .. TOPIC .. "/transcript\n"
  .. "sudo -u rocchat cp " .. DATA .. "/chat/offsets/3 " .. TOPIC .. "/offsets\n"
  .. "sudo -u rocchat cp " .. DATA .. "/chat/tallies/3 " .. TOPIC .. "/tally\n"
  .. "printf '%s\\n' 'topic v1 name=initial-work kind=human' | sudo -u rocchat tee " .. TOPIC .. "/topic >/dev/null\n"
  .. "printf '%s\\n' 'channel v1 name=RocChatDev members=" .. members .. "' | sudo -u rocchat tee " .. CHANNEL .. "/channel >/dev/null")

-- 4. Each copy is its source.
on_prod("set -e\n"
  .. "sudo cmp " .. DATA .. "/chat/transcripts/3 " .. TOPIC .. "/transcript\n"
  .. "sudo cmp " .. DATA .. "/chat/offsets/3 " .. TOPIC .. "/offsets\n"
  .. "sudo cmp " .. DATA .. "/chat/tallies/3 " .. TOPIC .. "/tally")
-- `wc` reads the file itself, as root: a `<` would be the ssh user's shell's.
local lines_moved = split(trim(on_prod("sudo wc -l " .. TOPIC .. "/transcript").out), " ")[1]
print("channel: " .. trim(on_prod("sudo cat " .. CHANNEL .. "/channel").out))
print("topic: " .. trim(on_prod("sudo cat " .. TOPIC .. "/topic").out))
print("moved " .. lines_moved .. " messages; conversation 3 is RocChatDev/initial-work: " .. PAGE)
