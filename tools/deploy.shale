-- This script deploys roc-chat, built on this box, to the prod droplet behind
-- its Caddy at https://chat.lynrummy.com. It runs from roc-chat's root, on
-- `main`, while the server runs. docs/deploy.md is the runbook.
--
--   shale tools/deploy.shale
--
-- It takes no argument. The ssh destination of the machine that serves the
-- chat, a user who may sudo there and the machine's IPv4 address,
-- `<user>@<IPv4>`, is the secret keys:prod-ssh, which the owner stores once
-- with `shale --secrets` (its `store`, the name `prod-ssh`); roc-apps'
-- site/deploy.shale reads the same one. It is the operator's, so the repo
-- names none, and this script never sees it either: every ssh and scp, and
-- the two `expr` checks below, get it through `run`'s `secret_args`, at
-- `<secret PROD>`, and Shale scrubs it from what they print. ssh's and
-- scp's own messages are off (LogLevel=QUIET), because they name the bare
-- address, which the scrubber does not know; a step whose ssh fails says so
-- by its exit, 255, and `ssh <user>@<address> true` by hand says why. Shale
-- confines every program to its mounts, and ssh's key is outside them, so
-- each ssh and scp to prod runs `unconfined`, which Shale allows for a host
-- of the box's hosts file (~/.config/shale/hosts) alone, and the push is
-- `git_push`'s, unconfined over ssh to a remote of the remotes file
-- (~/.config/shale/remotes) alone.
--
-- Each step refuses, by name, what it cannot do:
--
-- 1. It refuses unless the secret is `<user>@<IPv4>` and chat.lynrummy.com
--    resolves (through 1.1.1.1) to its address: `expr` matches the secret
--    against the address dig gives, so only "the same or not" reaches the
--    script. Then unless the tree is clean and on `main`, and prod's
--    Caddyfile imports /etc/caddy/sites/*.caddy and defines the `access_log`
--    snippet. That Caddyfile is angry-gopher's deploy/Caddyfile, and this
--    script never edits it.
-- 2. It makes, once, the `rocchat` system user, /opt/roc-chat (root's) and
--    /var/lib/roc-chat with data/ (rocchat's, mode 700).
-- 3. It refuses when .github-client-id or .github-client-secret is not in the
--    data root. The server reads them only at its start, and sign-up is by
--    GitHub, so it never starts without them.
-- 4. It builds the binary here: static (musl) and ReleaseSafe, so bcrypt runs
--    at release speed and the safety checks stay on. It builds C Shale here
--    too, static, from the Shale checkout beside this repo (`repos:shale`),
--    which must be clean: the admin scripts' runtime (docs/admin.md).
-- 5. It pushes `main` when `main` has an upstream, and says so when it has none.
-- 6. It refuses a file to ship that is not a plain file (a symbolic link is
--    not: scp copies what a link points at, wherever that is). It copies
--    the binary, proves the copy by its sha256, swaps it in whole by a
--    rename, and does the same for Shale (/opt/roc-chat/shale) and the admin
--    scripts and their mounts files (/opt/roc-chat/admin/), all root's. Then it
--    installs the systemd unit when it changed, restarts, and waits for
--    127.0.0.1:9611 to answer.
-- 7. It refuses to go on unless the first start seeded the chat: the owner's
--    account, the channel `general`, the counter of ids and .session-secret.
--    No sign-up can reach a server that lacks them.
-- 8. It installs deploy/chat.lynrummy.com.caddy when it changed, with its access
--    log made Caddy's first. Caddy validates the whole config before the reload,
--    and the old block goes back if the new one fails.
-- 9. Over HTTPS it checks the doors: `/` goes to Browse, `/chat` and `/agents`
--    go to sign in, `/login` is roc-chat's page and offers GitHub, and
--    `/login/github/start` goes to GitHub. Then it says whether the owner has
--    linked GitHub yet.
--
-- tools/deploy_test.shale tests what can be tested without prod: the
-- refusals of step 1, under a planted secrets mount.
--
-- budget: steps=50000000 programs=100

const SECRET = "keys:prod-ssh"
const NAME = "chat.lynrummy.com"
const ORIGIN = "https://chat.lynrummy.com"
const PORT = "9611"
const HOME = "/var/lib/roc-chat"
const DATA = "/var/lib/roc-chat/data"
const BIN = "/opt/roc-chat/roc-chat"
const SHALE_BIN = "/opt/roc-chat/shale"
const ADMIN = "/opt/roc-chat/admin"
-- What goes to ADMIN: the scripts tools/admin/ holds for prod, and the mounts
-- files they run under. check_remove_user.shale is a local test, and stays.
const ADMIN_FILES = {"tools/admin/chat_data.shale", "tools/admin/user_footprint.shale", "tools/admin/remove_user.shale", "deploy/admin/read.mounts", "deploy/admin/write.mounts"}
const UNIT = "roc-chat.service"
const BLOCK = "chat.lynrummy.com.caddy"
const LOG = "/var/log/caddy/chat-access.log"
const OUT = ".zig-cache/deploy"

if not exists("deploy/" .. BLOCK) or not exists("deploy/" .. UNIT) then fail("deploy: run it from roc-chat's root") end

-- `run`'s options `o` with the secret at `<secret PROD>`.
function with_dest(o)
  o.secret_args = {PROD = SECRET}
  return o
end

-- What a failed ssh or scp says: 255 is its own failure, any other exit the
-- command's.
function ssh_said(r, what)
  if r.code == 255 then return what .. ": ssh to prod failed (exit 255; its messages are off, so `ssh <user>@<address> true` by hand says why)" end
  return what .. ": exit " .. r.code .. ", " .. trim(r.out)
end

-- `script` run on prod by its shell, whatever its exit.
function ssh_to_prod(script, timeout)
  return run({"ssh", "-o", "BatchMode=yes", "-o", "LogLevel=QUIET", "<secret PROD>", script},
    with_dest({timeout_ms = timeout, whole = 100000, want = "ssh: the deploy's own steps on prod", unconfined = "deploy: ssh reads its key, outside the mounts"}))
end

-- A command on prod that must succeed.
function on_prod(script)
  local r = ssh_to_prod(script, 120000)
  if r.code ~= 0 then fail("deploy: " .. ssh_said(r, "a step on prod")) end
  return r
end

-- A command on prod whose exit is an answer: 0 is yes and 1 is no.
function asks_prod(script)
  local r = ssh_to_prod(script, 60000)
  if r.code ~= 0 and r.code ~= 1 then fail("deploy: prod could not be asked: " .. ssh_said(r, "a question")) end
  return r.code == 0
end

-- Stops unless the Shale path `p` is a plain file: a symbolic link (walk and
-- stat call it `other`) would send whatever it points at.
function stat_of(p)
  return stat(p)
end

function must_be_file(p)
  local s = attempt(stat_of, p)
  if not s.ok or s.value.kind ~= "file" then fail("deploy: " .. p .. " is not a plain file (a symbolic link is not), so it is not shipped") end
  return nil
end

function copy_to_prod(local_path, remote_path)
  local r = run({"scp", "-q", "-O", "-o", "BatchMode=yes", "-o", "LogLevel=QUIET", local_path, "<secret PROD>:" .. remote_path},
    with_dest({timeout_ms = 300000, whole = 10000, want = "scp: the deploy's copy to prod", unconfined = "deploy: scp reads its key, outside the mounts"}))
  if r.code ~= 0 then fail("deploy: " .. ssh_said(r, "the copy of " .. local_path .. " to prod's " .. remote_path)) end
end

-- Whether the secret matches the BRE `pattern`, whole: expr prints the
-- match's length, which stays here, and exits 0 for a match, 1 for none.
function secret_matches(pattern)
  local r = run({"expr", "<secret PROD>", ":", pattern}, with_dest({timeout_ms = 10000, tail = 1}))
  if r.code ~= 0 and r.code ~= 1 then fail("deploy: expr could not match " .. SECRET .. ": exit " .. r.code .. ", " .. trim(r.out)) end
  return r.code == 0
end

-- The Location of a GET of `path`, which must be a 303.
function location_of(path)
  local r = http("GET", ORIGIN .. path)
  local where = ""
  if has_key(r.headers, "location") then where = r.headers.location end
  if r.status ~= 303 then fail("deploy: " .. ORIGIN .. path .. " answers " .. r.status .. ", not a 303") end
  return where
end

function must_send(path, to)
  local where = location_of(path)
  if where ~= to then fail("deploy: " .. ORIGIN .. path .. " sends the browser to '" .. where .. "', not " .. to) end
end

-- 1. The refusals that change nothing: the secret's shape, then the name's
-- address against it.
if not secret_matches("[a-z_][a-z0-9_-]*@[0-9][0-9]*\\.[0-9][0-9]*\\.[0-9][0-9]*\\.[0-9][0-9]*$") then
  fail("deploy: " .. SECRET .. " is not `<user>@<IPv4>`, the ssh destination of the machine that serves the chat: store it again with `shale --secrets`")
end
local dns = run({"dig", "+short", "@1.1.1.1", "A", NAME}, {timeout_ms = 30000, whole = 10000, want = "dig: the name's public answer"})
local resolved = trim(dns.out)
local last = ""
for line in lines(resolved) do last = trim(line) end
if dns.code ~= 0 or re_find(last, "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$") == nil then
  fail("deploy: " .. NAME .. " does not resolve to an IPv4 address through 1.1.1.1 (dig said '" .. resolved .. "'); the DNS record comes first")
end
if not secret_matches(".*@" .. join(split(last, "."), "\\.") .. "$") then
  fail("deploy: " .. NAME .. " resolves to " .. last .. ", not the address in " .. SECRET .. "; the DNS record comes first")
end
local dirty = run({"git", "status", "--porcelain"}, {timeout_ms = 30000, whole = 100000})
if trim(dirty.out) ~= "" then fail("deploy: the tree has changes not committed; commit them first:\n" .. dirty.out) end
local branch = trim(must(run({"git", "rev-parse", "--abbrev-ref", "HEAD"}, {timeout_ms = 10000, whole = 1000})).out)
if branch ~= "main" then fail("deploy: the checkout is on `" .. branch .. "`; prod serves main") end
if not asks_prod("grep -qxF 'import /etc/caddy/sites/*.caddy' /etc/caddy/Caddyfile") then
  fail("deploy: prod's Caddyfile does not import /etc/caddy/sites/*.caddy (angry-gopher's deploy/Caddyfile does)")
end
if not asks_prod("grep -q '^(access_log) {' /etc/caddy/Caddyfile") then
  fail("deploy: prod's Caddyfile does not define the access_log snippet " .. BLOCK .. " imports (angry-gopher's deploy/Caddyfile does)")
end

-- 2. The user and the folders, once.
on_prod("set -e\n"
  .. "id rocchat >/dev/null 2>&1 || sudo useradd --system --home-dir " .. HOME .. " --no-create-home --shell /usr/sbin/nologin rocchat\n"
  .. "sudo install -d -o root -g root -m 755 /opt/roc-chat\n"
  .. "sudo install -d -o rocchat -g rocchat -m 700 " .. HOME .. " " .. DATA)

-- 3. The OAuth app's id and secret, which the owner writes on prod.
for name in {".github-client-id", ".github-client-secret"} do
  if not asks_prod("sudo test -s " .. DATA .. "/" .. name) then
    fail("deploy: " .. DATA .. "/" .. name .. " is missing or empty on prod; see docs/deploy.md, \"GitHub setup\"")
  end
end

-- The sha256 of a file here, as 64 hex digits.
function sha256_of(path)
  return split(trim(must(run({"sha256sum", path}, {timeout_ms = 30000, whole = 1000})).out), " ")[1]
end

-- 4. The binaries: the server, then C Shale, static with glibc (it links
-- only the C library, and has no name lookups for a static link to miss),
-- built as c/build/binary.shale's release build is, plus `-static`.
must(run({"zig", "build", "-Dtarget=x86_64-linux-musl", "-Doptimize=ReleaseSafe", "--prefix", OUT}, {timeout_ms = 900000, tail = 20}))
local built = OUT .. "/bin/roc-chat"
print("built " .. built .. " (sha256 " .. sub(sha256_of(built), 1, 12) .. ")")
if not git_is_clean("repos:shale") then fail("deploy: the Shale checkout, repos:shale, has changes; prod's Shale is built from a clean one") end
must(run({"tcc", "-run", "c/gen_preludes.c"}, {cwd = "repos:shale", timeout_ms = 60000, tail = 5}))
const SHALE_BUILT = OUT .. "/shale"
must(run({"gcc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-Ic/foundation", "-O2", "-Ic/out/gen", "-Ic", "c/shale.c", "-static", "-o", real(OUT) .. "/shale"},
  {cwd = "repos:shale", timeout_ms = 300000, tail = 40, nice = 19}))
print("built " .. SHALE_BUILT .. " from Shale " .. git_head("repos:shale") .. " (sha256 " .. sub(sha256_of(SHALE_BUILT), 1, 12) .. ")")

-- 5. The push: git_push's, unconfined over ssh (its key is outside the
-- mounts), `main` to its upstream's branch of the same name.
if git_upstream("") == nil then
  print("main has no upstream, so nothing is pushed: what serves is on this box alone")
else
  git_push("")
end
local commit = trim(must(run({"git", "rev-parse", "--short", "HEAD"}, {timeout_ms = 10000, whole = 1000})).out)
print("deploying roc-chat " .. commit .. " to prod (" .. SECRET .. ")")

-- Everything copied to prod is staged in a folder of its own, made fresh under
-- the deploy user's home with mode 700 and a name no one can guess, so no other local
-- user can plant a file there first.
const STAGE = trim(on_prod("mktemp -d -p \"$HOME\" roc-chat-deploy.XXXXXXXX").out)
if find(STAGE, "/roc-chat-deploy.") == nil then fail("deploy: no staging folder on prod (mktemp said `" .. STAGE .. "`)") end

-- The file `local_path` put at `remote_path` on prod, root's with `mode`: copied
-- to the staging folder, proved by its sha256, then swapped in whole by a
-- rename.
function install_on_prod(local_path, remote_path, mode)
  local staged = STAGE .. "/" .. basename(remote_path) .. ".new"
  must_be_file(local_path)
  local want = sha256_of(local_path)
  copy_to_prod(real(local_path), staged)
  local got = split(trim(on_prod("sha256sum " .. staged).out), " ")[1]
  if got ~= want then fail("deploy: the copy of " .. local_path .. " on prod is not this one (sha256 " .. got .. ", want " .. want .. ")") end
  on_prod("set -e\nsudo install -o root -g root -m " .. mode .. " " .. staged .. " " .. remote_path .. ".new\nsudo mv -f " .. remote_path .. ".new " .. remote_path .. "\nrm -f " .. staged)
end

-- 6. The binaries, the admin scripts, the unit and the restart.
install_on_prod(built, BIN, "755")
install_on_prod(SHALE_BUILT, SHALE_BIN, "755")
on_prod("sudo install -d -o root -g root -m 755 " .. ADMIN)
for f in ADMIN_FILES do install_on_prod(f, ADMIN .. "/" .. basename(f), "644") end
print("installed " .. SHALE_BIN .. " and " .. #ADMIN_FILES .. " files in " .. ADMIN)
must_be_file("deploy/" .. UNIT)
copy_to_prod("deploy/" .. UNIT, STAGE .. "/" .. UNIT)
-- cmp exits 2 on a file that is not there, so a first deploy's unit counts as changed.
if asks_prod("[ -f /etc/systemd/system/" .. UNIT .. " ] && cmp -s " .. STAGE .. "/" .. UNIT .. " /etc/systemd/system/" .. UNIT) then
  print("the unit is unchanged")
else
  on_prod("set -e\nsudo install -o root -g root -m 644 " .. STAGE .. "/" .. UNIT .. " /etc/systemd/system/" .. UNIT .. "\nsudo systemctl daemon-reload\nsudo systemctl enable roc-chat")
  print("installed the unit")
end
on_prod("rm -f " .. STAGE .. "/" .. UNIT)
on_prod("set -e\nsudo systemctl restart roc-chat\n"
  .. "for _ in $(seq 1 50); do curl -fsS -o /dev/null http://127.0.0.1:" .. PORT .. "/login 2>/dev/null && break; sleep 0.1; done\n"
  .. "systemctl is-active roc-chat\n"
  .. "curl -fsS -o /dev/null http://127.0.0.1:" .. PORT .. "/login")
print("roc-chat " .. commit .. " answers on prod's 127.0.0.1:" .. PORT)

-- 7. What the first start seeds, before any sign-up can arrive.
for name in {"auth/1/name", "auth/next-id.txt", "chat/channel/general.channel", ".session-secret"} do
  if not asks_prod("sudo test -s " .. DATA .. "/" .. name) then
    fail("deploy: " .. DATA .. "/" .. name .. " is missing or empty after the start, so the chat is not seeded; the site block is left as it was")
  end
end

-- 8. The site block, validated before it counts.
must_be_file("deploy/" .. BLOCK)
copy_to_prod("deploy/" .. BLOCK, STAGE .. "/" .. BLOCK)
if asks_prod("[ -f /etc/caddy/sites/" .. BLOCK .. " ] && cmp -s " .. STAGE .. "/" .. BLOCK .. " /etc/caddy/sites/" .. BLOCK) then
  print("the site block is unchanged")
else
  on_prod("set -e\n"
    .. "sudo install -d -m 755 /etc/caddy/sites\n"
    .. "# The log is made Caddy's before validate, which runs as root and would make it root's.\n"
    .. "[ -f " .. LOG .. " ] || sudo install -o caddy -g caddy -m 640 /dev/null " .. LOG .. "\n"
    .. "if [ -f /etc/caddy/sites/" .. BLOCK .. " ]; then sudo cp /etc/caddy/sites/" .. BLOCK .. " " .. STAGE .. "/" .. BLOCK .. ".old; else rm -f " .. STAGE .. "/" .. BLOCK .. ".old; fi\n"
    .. "sudo install -m 644 " .. STAGE .. "/" .. BLOCK .. " /etc/caddy/sites/" .. BLOCK .. "\n"
    .. "if ! sudo caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile >" .. STAGE .. "/" .. BLOCK .. ".validate 2>&1; then\n"
    .. "  tail -5 " .. STAGE .. "/" .. BLOCK .. ".validate\n"
    .. "  if [ -f " .. STAGE .. "/" .. BLOCK .. ".old ]; then sudo install -m 644 " .. STAGE .. "/" .. BLOCK .. ".old /etc/caddy/sites/" .. BLOCK .. "; else sudo rm -f /etc/caddy/sites/" .. BLOCK .. "; fi\n"
    .. "  echo 'the new block did not validate; the old one is back'; exit 1\n"
    .. "fi\n"
    .. "sudo systemctl reload caddy\n"
    .. "rm -f " .. STAGE .. "/" .. BLOCK .. ".old " .. STAGE .. "/" .. BLOCK .. ".validate")
  print("installed the site block")
end
on_prod("rm -f " .. STAGE .. "/" .. BLOCK)

on_prod("rm -rf " .. STAGE)

-- 9. The doors, over HTTPS. The first try uses curl, not http(), because a
-- handshake that fails while Caddy reloads is a try to repeat, not an error.
local code = ""
local tries = 0
while tries < 30 do
  local r = run({"curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", ORIGIN .. "/login"}, {timeout_ms = 30000, whole = 10000, want = "curl: a try at the front door, its failures expected while Caddy reloads"})
  code = trim(r.out)
  if code == "200" then break end
  tries = tries + 1
  sleep(2000)
end
if code ~= "200" then fail("deploy: " .. ORIGIN .. "/login answers '" .. code .. "', not 200, after a minute") end
local login = http("GET", ORIGIN .. "/login")
local corp = ""
if has_key(login.headers, "cross-origin-resource-policy") then corp = login.headers["cross-origin-resource-policy"] end
if login.status ~= 200 or corp ~= "same-origin" then
  fail("deploy: " .. ORIGIN .. "/login answers " .. login.status .. " with Cross-Origin-Resource-Policy '" .. corp .. "': not roc-chat's sign-in page")
end
if find(login.body, "/login/github/start") == nil then fail("deploy: " .. ORIGIN .. "/login offers no GitHub sign-in: the server did not take its GitHub files") end
must_send("/", "/chat")
must_send("/chat", "/login?next=/chat")
must_send("/agents", "/login?next=/agents")
if not starts_with(location_of("/login/github/start"), "https://github.com/login/oauth/authorize?") then
  fail("deploy: " .. ORIGIN .. "/login/github/start does not send the browser to GitHub's authorize page")
end
print("deployed: " .. ORIGIN .. "/ (roc-chat " .. commit .. "); the doors answer as they should")
if asks_prod("sudo test -s " .. DATA .. "/auth/1/github-id") then
  print("the owner has linked GitHub")
else
  print("the owner has not linked GitHub yet: docs/deploy.md, \"Linking the owner's GitHub account\", comes before signing in with GitHub")
end
