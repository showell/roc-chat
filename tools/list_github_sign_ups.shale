-- This script lists the humans of a roc-chat data folder who look like they
-- signed up with GitHub before the `sign-up` file existed: an account folder
-- (`auth/<id>/` holding `name`) with a `github-id`, no `inviter`, no
-- `password`, no `sign-up`, and an id other than the owner's, 1. It writes
-- nothing: the owner reads the list, and writes `github` into each one's
-- `auth/<id>/sign-up` by hand if they agree (docs/design.md, "Storage").
--
-- A folder released for its name (`name-released`) is no account and is left
-- out. Run it with the data folder as Shale's root, or name the folder below
-- the root as `data=`:
--
--   cd /path/to/data && shale /path/to/roc-chat/tools/list_github_sign_ups.shale
--   shale tools/list_github_sign_ups.shale data=demo/data
const DATA = arg("data", ".")

function under(name)
  if DATA == "." or DATA == "" then return name end
  return DATA .. "/" .. name
end

if not exists(under("auth/next-id.txt")) then fail("list_github_sign_ups: " .. DATA .. " holds no auth/next-id.txt: not a roc-chat data folder") end

local rows = {}
for path in glob(under("auth/*/name")) do
  local entry = basename(dirname(path))
  local id = re_find(entry, "^[0-9]+$")
  if id ~= nil and entry ~= "1" then
    local folder = under("auth/" .. entry)
    local is_account = exists(folder .. "/name") and not exists(folder .. "/name-released")
    local looks_github = exists(folder .. "/github-id") and not exists(folder .. "/inviter") and not exists(folder .. "/password")
    if is_account and looks_github and not exists(folder .. "/sign-up") then
      push(rows, {id = parse_int(entry), name = trim(read(folder .. "/name")), github = trim(read(folder .. "/github-id"))})
    end
  end
end
sort(rows, "id")
if #rows == 0 then
  print("no candidates: every account that looks like a GitHub sign-up has its sign-up file")
else
  print(table(rows, {"id", "name", "github"}))
  print(#rows .. " candidates; nothing written")
end
