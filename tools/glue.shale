-- **ROC GLUE'S SNAPSHOT OF THE SEAM, REGENERATED**: what
-- host/seam_test.zig holds host/seam.zig to. Run from gopher-roc's root
-- after any change to platform/ (Host.roc's primitives, Http.roc's
-- records):
--   shale tools/glue.shale
-- `roc glue` with the pinned compiler (roc-version) and the spec from
-- Roc's source at the same commit (tools:roc-<commit>, which the compiler
-- does not ship), into .zig-cache/roc-glue, then `zig fmt`, then written
-- over host/glue/platform_abi.zig. Says whether the snapshot changed;
-- commit it with the change that moved it.

const out_dir = ".zig-cache/roc-glue"
const snapshot = "host/glue/platform_abi.zig"

if not exists("platform/main.roc") then
  fail("glue: run it from gopher-roc's root (no platform/main.roc here)")
end

-- Glue from another Roc lays out another Roc's records.
const pin = trim(read("roc-version"))
const roc = real("tools:roc-" .. pin .. "/roc")
local parts = split(pin, "-")
const spec = "tools:roc-" .. parts[#parts] .. "/src/glue/src/ZigGlue.roc"
if not exists(spec) then
  fail("glue: no glue spec at " .. spec .. ": check out roc-lang/roc at " .. parts[#parts] .. " as ~/tools/roc-" .. parts[#parts])
end

if exists(out_dir) then remove_tree(out_dir) end
mkdir(out_dir)
must(run({roc, "glue", real(spec), out_dir, "platform/main.roc"}, {timeout_ms = 120000, tail = 20}))
const made = out_dir .. "/roc_platform_abi.zig"
must(run({"zig", "fmt", made}, {timeout_ms = 60000, tail = 20}))

local after = read(made)
if exists(snapshot) and read(snapshot) == after then
  print("glue: " .. snapshot .. " unchanged (roc " .. pin .. ")")
else
  if not exists("host/glue") then mkdir("host/glue") end
  replace(snapshot, after)
  print("glue: " .. snapshot .. " written (roc " .. pin .. "): `zig build test` checks the seam against it")
end
