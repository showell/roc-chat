-- This is the one-time rename on the prod droplet: gopher-roc becomes roc-chat,
-- and the stopped program that held that name goes. Delete this file once it has
-- run. It runs from this box over ssh, from the repo's root, on a clean `main`
-- that carries the rename, one step at a time, and stops at the first failure.
--
--   zig build -Dtarget=x86_64-linux-musl -Doptimize=ReleaseSafe --prefix .zig-cache/deploy
--   shale tools/rename_prod.shale
--   shale tools/deploy.shale
--
-- a. It refuses, changing nothing, unless the binary is built and current, the
--    tree is clean on `main`, gopher-roc is active, roc-chat is neither active
--    nor enabled, and everything steps d to f will touch is what it should be.
--    These checks all run here, before the outage, so a surprise costs nothing.
-- b. It backs up /var/lib/gopher-roc to a root-owned mode-600 tar in steve's home
--    on prod, proves the tar reads with `tar tzf`, and prints its path.
-- c. It stops and disables gopher-roc. The site answers 502 from here until
--    tools/deploy.shale ends.
-- d. It removes the old program: its unit, /opt/roc-chat, /var/lib/roc-chat and
--    ~/roc-chat-rollback, each by its exact path and checked again first.
-- e. It moves /var/lib/gopher-roc to /var/lib/roc-chat and gives it to `rocchat`,
--    and proves the modes did not change.
-- f. It removes gopher-roc's unit, /opt/gopher-roc and the user `gopherroc`, then
--    reloads systemd.
-- g. It prints that tools/deploy.shale comes next. Caddy keeps port 9611.
--
-- The way back depends on where it stopped. BACKUP is the path step b printed.
-- Every command here runs on prod. The tar was made before the stop, so it lacks
-- whatever was posted between b and c. Use the live folder when it is whole.
--
-- A refusal, or a stop at a or b: nothing has changed, and gopher-roc still serves.
--
-- A stop at c or d: the data has not moved, and gopher-roc's binary, unit and user
-- are all there.
--
--   sudo systemctl enable --now gopher-roc
--
-- A stop at e: gopher-roc's binary, unit and user are still there. Bring the data
-- back to /var/lib/gopher-roc, from the live folder when the move happened:
--
--   sudo mv -T /var/lib/roc-chat /var/lib/gopher-roc
--   sudo chown -R gopherroc:gopherroc /var/lib/gopher-roc
--
-- or, when that folder is damaged, from the backup, with nothing at either path:
--
--   sudo tar xzpf BACKUP -C /var/lib
--
-- Then:
--
--   sudo systemctl enable --now gopher-roc
--
-- A stop at f, or a failed deploy after it: gopher-roc may be partly gone, so the
-- way out is forward. Finish whatever f left, then run tools/deploy.shale, which
-- makes the binary and the unit anew over /var/lib/roc-chat. If the data is
-- damaged, restore it from the backup first:
--
--   sudo rm -rf /var/lib/roc-chat
--   sudo tar xzpf BACKUP -C /var/lib --transform 's,^gopher-roc,roc-chat,'
--   sudo chown -R rocchat:rocchat /var/lib/roc-chat
--
-- A rerun after any stop past b refuses, as gopher-roc is no longer active.
--
-- Nothing here prints the data folder's contents. The secrets are only tarred and
-- moved, and what is printed of them is their names, owners and modes.

const HOST = "steve@162.243.1.123"
const OLD_DATA = "/var/lib/gopher-roc"
const NEW_DATA = "/var/lib/roc-chat"
const BUILT = ".zig-cache/deploy/bin/roc-chat"
const BUILD = {"zig", "build", "-Dtarget=x86_64-linux-musl", "-Doptimize=ReleaseSafe", "--prefix", ".zig-cache/deploy"}

-- What steps d and f remove, each with the shell test that says it is what it
-- should be. The paths are written out so no value of any variable can widen one.
const OLD_PROGRAM = {
  {path = "/etc/systemd/system/roc-chat.service", is = "sudo test -f /etc/systemd/system/roc-chat.service && ! sudo test -L /etc/systemd/system/roc-chat.service && sudo grep -q /opt/roc-chat /etc/systemd/system/roc-chat.service"},
  {path = "/opt/roc-chat", is = "sudo test -d /opt/roc-chat && ! sudo test -L /opt/roc-chat && [ \"$(sudo du -sm /opt/roc-chat | cut -f1)\" -le 200 ]"},
  {path = "/var/lib/roc-chat", is = "sudo test -d /var/lib/roc-chat && ! sudo test -L /var/lib/roc-chat && [ \"$(sudo stat -c %U /var/lib/roc-chat)\" = rocchat ] && sudo test -f /var/lib/roc-chat/config.zon && sudo test -d /var/lib/roc-chat/data && [ \"$(sudo du -sm /var/lib/roc-chat | cut -f1)\" -le 16 ]"},
  {path = "/home/steve/roc-chat-rollback", is = "test -d /home/steve/roc-chat-rollback && ! test -L /home/steve/roc-chat-rollback && test -f /home/steve/roc-chat-rollback/chat.lynrummy.com.caddy && [ \"$(du -sm /home/steve/roc-chat-rollback | cut -f1)\" -le 1 ]"},
}
const GOPHER_ROC = {
  {path = "/etc/systemd/system/gopher-roc.service", is = "sudo test -f /etc/systemd/system/gopher-roc.service && ! sudo test -L /etc/systemd/system/gopher-roc.service && sudo grep -q /opt/gopher-roc/gopher-roc /etc/systemd/system/gopher-roc.service"},
  {path = "/opt/gopher-roc", is = "sudo test -d /opt/gopher-roc && ! sudo test -L /opt/gopher-roc && sudo test -x /opt/gopher-roc/gopher-roc && [ \"$(sudo du -sm /opt/gopher-roc | cut -f1)\" -le 200 ]"},
}

if not exists("deploy/roc-chat.service") or not exists("tools/deploy.shale") then fail("rename_prod: run it from roc-chat's root") end

-- A command on prod that must succeed.
function on_prod(script)
  return must(run({"ssh", HOST, script}, {timeout_ms = 120000, whole = 100000, want = "ssh: the rename's own steps on prod"}))
end

-- A command on prod whose exit is an answer: 0 is yes and 1 is no.
function asks_prod(script)
  local r = run({"ssh", HOST, "if " .. script .. "; then exit 0; else exit 1; fi"}, {timeout_ms = 60000, whole = 100000, want = "ssh: a question to prod, its exit the answer"})
  if r.code ~= 0 and r.code ~= 1 then fail("rename_prod: prod could not be asked (ssh exit " .. r.code .. "): " .. trim(r.out)) end
  return r.code == 0
end

function refuse_unless(what, script)
  if not asks_prod(script) then fail("rename_prod: refused, and nothing has changed: " .. what) end
end

function step(name, script)
  print(name)
  local said = trim(on_prod(script).out)
  if said ~= "" then print(said) end
end

-- Removes each of `items`, checking it first, and proves it gone.
function remove_each(items)
  for item in items do
    if not asks_prod(item.is) then fail("rename_prod: " .. item.path .. " is not what it should be, so it stays") end
    on_prod("set -eu\nsudo rm -rf -- " .. item.path .. "\n! sudo test -e " .. item.path)
    print("  removed " .. item.path)
  end
end

function sha256_of(path)
  return split(trim(must(run({"sha256sum", path}, {timeout_ms = 30000, whole = 1000})).out), " ")[1]
end

-- a. The refusals, all before anything changes.
print("a. checking")
local dirty = run({"git", "status", "--porcelain"}, {timeout_ms = 30000, whole = 100000})
if trim(dirty.out) ~= "" then fail("rename_prod: refused: the tree has changes not committed, and tools/deploy.shale would refuse them mid-outage:\n" .. dirty.out) end
local branch = trim(must(run({"git", "rev-parse", "--abbrev-ref", "HEAD"}, {timeout_ms = 10000, whole = 1000})).out)
if branch ~= "main" then fail("rename_prod: refused: the checkout is on `" .. branch .. "`, and tools/deploy.shale deploys only main") end

-- This is tools/deploy.shale's build. Zig answers from its cache when the binary
-- is current, so a binary that changes here was stale, and the deploy would have
-- rebuilt it for minutes while the site was down.
if not exists(BUILT) then fail("rename_prod: refused: " .. BUILT .. " is not built; run: " .. join(BUILD, " ")) end
local sum_before = sha256_of(BUILT)
must(run(BUILD, {timeout_ms = 900000, tail = 20}))
if sha256_of(BUILT) ~= sum_before then fail("rename_prod: refused: " .. BUILT .. " was stale and is rebuilt now; run this again") end
print("  the binary is built and current (sha256 " .. sub(sum_before, 1, 12) .. ")")

refuse_unless("sudo needs a password on prod", "sudo -n true")
refuse_unless("steve's home on prod is not /home/steve", "[ \"$HOME\" = /home/steve ]")
refuse_unless("gopher-roc is not active", "systemctl is-active --quiet gopher-roc")
if asks_prod("systemctl is-active --quiet roc-chat") then fail("rename_prod: refused, and nothing has changed: roc-chat is active") end
if asks_prod("systemctl is-enabled --quiet roc-chat") then fail("rename_prod: refused, and nothing has changed: roc-chat is enabled") end
refuse_unless("prod has other units under these names", "[ \"$(systemctl list-unit-files --no-legend 'roc-chat*' 'gopher-roc*' | wc -l)\" = 2 ]")
refuse_unless("there is no user `rocchat`", "id rocchat >/dev/null 2>&1")
refuse_unless("there is no user `gopherroc`", "id gopherroc >/dev/null 2>&1")
if asks_prod("pgrep -u rocchat >/dev/null") then fail("rename_prod: refused, and nothing has changed: `rocchat` has a process running") end
refuse_unless(OLD_DATA .. " is not gopherroc's real folder with data/ inside", "sudo test -d " .. OLD_DATA .. "/data && ! sudo test -L " .. OLD_DATA .. " && [ \"$(sudo stat -c %U " .. OLD_DATA .. ")\" = gopherroc ]")
for name in {".github-client-id", ".github-client-secret", ".session-secret", "auth/1/name"} do
  refuse_unless(OLD_DATA .. "/data/" .. name .. " is missing or empty", "sudo test -s " .. OLD_DATA .. "/data/" .. name)
end
for item in OLD_PROGRAM do refuse_unless(item.path .. " is not what it should be", item.is) end
for item in GOPHER_ROC do refuse_unless(item.path .. " is not what it should be", item.is) end
print("  prod is as expected")

-- b. The backup. tar writes under umask 077, so the file is never open to anyone.
-- The listing stays on prod: only its count is printed.
local stamp = trim(on_prod("date -u +%Y%m%dT%H%M%SZ").out)
const backup = "/home/steve/gopher-roc-data-" .. stamp .. ".tgz"
step("b. backing up " .. OLD_DATA, "set -eu\n"
  .. "if sudo test -e " .. backup .. "; then echo 'a backup of that name is already there'; exit 1; fi\n"
  .. "sudo sh -c 'umask 077 && exec tar czf " .. backup .. " -C /var/lib gopher-roc'\n"
  .. "[ \"$(sudo stat -c '%U %a' " .. backup .. ")\" = 'root 600' ]\n"
  .. "sudo tar tzf " .. backup .. " >/dev/null\n"
  .. "sudo tar tzf " .. backup .. " | grep -qxF gopher-roc/data/auth/1/name\n"
  .. "sudo tar tzf " .. backup .. " | grep -qxF gopher-roc/data/.session-secret\n"
  .. "echo \"  $(sudo tar tzf " .. backup .. " | wc -l) entries read back; $(sudo find " .. OLD_DATA .. " | wc -l) in the folder\"")
print("  the backup, root's and mode 600: " .. backup)

-- c. The stop.
step("c. stopping gopher-roc; the site answers 502 until tools/deploy.shale ends", "set -eu\n"
  .. "sudo systemctl disable --now gopher-roc\n"
  .. "if systemctl is-active --quiet gopher-roc; then echo 'gopher-roc is still active'; exit 1; fi\n"
  .. "if pgrep -u gopherroc >/dev/null; then echo '`gopherroc` still has a process'; exit 1; fi")

-- d. The old program.
print("d. removing the old program")
remove_each(OLD_PROGRAM)

-- e. The move. `mv -T` fails on a non-empty folder at the target, where a plain
-- `mv` would put the data inside it. The digest covers each path's mode and type.
const modes = "sudo find " .. NEW_DATA .. " -printf '%m %y %p\\n' | LC_ALL=C sort | sha256sum"
step("e. moving " .. OLD_DATA .. " to " .. NEW_DATA, "set -eu\n"
  .. "sudo mv -T " .. OLD_DATA .. " " .. NEW_DATA .. "\n"
  .. "before=$(" .. modes .. ")\n"
  .. "sudo chown -R rocchat:rocchat " .. NEW_DATA .. "\n"
  .. "after=$(" .. modes .. ")\n"
  .. "if [ \"$before\" != \"$after\" ]; then echo 'the modes changed'; exit 1; fi\n"
  .. "strays=$(sudo find " .. NEW_DATA .. " ! -user rocchat -o ! -group rocchat | wc -l)\n"
  .. "if [ \"$strays\" != 0 ]; then echo \"$strays paths are not rocchat's\"; exit 1; fi\n"
  .. "sudo stat -c '  %U %a %n' " .. NEW_DATA .. " " .. NEW_DATA .. "/data " .. NEW_DATA .. "/data/.session-secret " .. NEW_DATA .. "/data/.github-client-id " .. NEW_DATA .. "/data/.github-client-secret")

-- f. What is left of the old name. userdel takes the group of the same name
-- unless the system's settings say otherwise, so the group is checked apart.
print("f. removing gopher-roc's unit, folder and user")
remove_each(GOPHER_ROC)
step("  removing the user `gopherroc` and reloading systemd", "set -eu\n"
  .. "sudo userdel gopherroc\n"
  .. "if getent group gopherroc >/dev/null; then sudo groupdel gopherroc; fi\n"
  .. "sudo systemctl daemon-reload")

-- g. What comes next.
print("g. prod is renamed, and nothing serves chat.lynrummy.com yet")
print("  next: shale tools/deploy.shale, which installs the unit and starts the server")
print("  Caddy's site block keeps port 9611")
print("  the backup stays at " .. backup .. " until you remove it")
