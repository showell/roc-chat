-- This is the gate: every check, cheapest first, the slow end last. Run
-- it from gopher-roc's root; it fails, naming each check that did.
--
--   shale tools/verify.shale
--
-- 1. `roc fmt --check`: the code is laid out as the formatter lays it;
--    and every `app/*.js` (the page's script, which a Roc module imports
--    whole) parses, by shale's cookbook:syntax.shale.
-- 2. `roc test`, twice: from the app (every production module's expects)
--    and from app/Specs.roc (every `*Spec.roc`), none failing. Each
--    `app/*.roc`'s top-level expects (its lines starting `expect`) are
--    exactly the lines that pass for it, `PASS: app/<file>:<line>` from
--    either run, each counted once; roc-markdown's, which the runs include,
--    never count. The source is the count, so no floor needs keeping, and an
--    expect that stops running fails here. Every `app/*Spec.roc` is
--    imported by app/Specs.roc, the only run that reaches it.
-- 3. The style hunts (shale's cookbook/roc), each held to zero on what it
--    judges: names, errors, nesting, boundaries, stacking, and `methods`
--    (no `Module.fn(x, ...)` call that would check as `x.fn(...)`, judged
--    by Roc's own types from both apps, app/main.roc and app/Specs.roc; its
--    trials are written in place and put back, so it runs under
--    `--undo-on-stop`, and its calls left are the types' reasons, not
--    findings). Their other
--    counts are questions for a reader, so they print but don't gate:
--    stack's long lines (a frozen answer or a long string has nothing to
--    stack), boundaries' `single`, `entry`, `constant` and `bool_param`,
--    and name_hunt's
--    `stacked_preposition`, which are rules of thumb.
-- 4. The demo built through the host, its page exactly the frozen
--    demo/gopher-roc.html.
-- 5. The host's Zig tests (`zig build test`): the file primitives, the
--    seam held to roc glue's layout, the HTTP layer.
-- 6. Last, the end to end (`zig build end-to-end`): the real server on a
--    free port of 127.0.0.1, against a temporary data root, driven over
--    HTTP; it stops the server and removes the root, pass or fail.
--
-- budget: steps=200000000

const ROC = "/home/steve/tools/roc-" .. trim(read("roc-version")) .. "/roc"

const board = {failed = 0}

function say(ok, what)
  local mark = "FAIL"
  if ok then mark = "PASS" end
  if not ok then board.failed = board.failed + 1 end
  print(mark .. "  " .. what)
end

-- 1. The layout.
local fmt = run({ROC, "fmt", "--check", "app", "platform"}, {timeout_ms = 60000, tail = 10})
say(fmt.code == 0, "roc fmt --check app platform")

local scripts = glob("app/*.js")
local parsed = run({"shale", real("cookbook:syntax.shale"), "files=" .. join(scripts, ",")}, {cwd = ".", timeout_ms = 60000, whole = 100000})
say(#scripts > 0 and parsed.code == 0 and find(parsed.out, "PASS: " .. #scripts .. " files") ~= nil, "the scripts parse: " .. join(scripts, ", "))
if parsed.code ~= 0 then print(parsed.out) end

-- 2. The expects, from each root; each of ours is a `PASS: app/<file>:<line>`.
const roots = {
  {"test", "--verbose", "app/main.roc"},
  {"test", "--verbose", "app/Specs.roc"},
}
const passed = {}
local all_passed = true
for argv in roots do
  local full = {ROC}
  for a in argv do push(full, a) end
  local tested = run(full, {timeout_ms = 300000, whole = 2000000})
  local ok = tested.code == 0 and re_find(tested.out, "All \\([0-9]+\\) tests passed") ~= nil
  if not ok then
    all_passed = false
    print(tested.out)
  end
  for l in re_lines(tested.out, "^PASS: app/") do passed[trim(sub(l.text, 7))] = true end
end
say(all_passed, "roc test, the app and the specs: none failed")

-- Each file's expects, from its source, against what passed for it.
const written = {}
local total = 0
local astray = 0
for path in glob("app/*.roc") do
  local count = 0
  for m in re_lines(read(path), "^expect( |$)") do
    written[path .. ":" .. m.line] = true
    count = count + 1
    if not has_key(passed, path .. ":" .. m.line) then
      astray = astray + 1
      print("  not passed: " .. path .. ":" .. m.line)
    end
  end
  total = total + count
end
for at in keys(passed) do
  if not has_key(written, at) then
    astray = astray + 1
    print("  passed, but no top-level expect in the source: " .. at)
  end
end
say(astray == 0, "every expect in app/*.roc passed, once: " .. total .. " in the source, " .. #keys(passed) .. " passed")

-- Every Spec reaches a run.
const specs = read("app/Specs.roc")
local unimported = 0
for path in glob("app/*Spec.roc") do
  local name = basename(path)
  local module = sub(name, 1, #name - 4)
  if #re_lines(specs, "^import " .. module .. "$") == 0 then
    unimported = unimported + 1
    print("  not imported by app/Specs.roc: " .. module)
  end
end
say(unimported == 0, "every app/*Spec.roc imported by app/Specs.roc")

-- 3. The hunts, each count read from its summary line.
const hunts = {
  {recipe = "name_hunt", args = {}, counts = {"state_effect ([0-9]+)", "question ([0-9]+)", "vague ([0-9]+)", "name_type ([0-9]+)", "negative ([0-9]+)", "noun_effect ([0-9]+)", "command_tense ([0-9]+)", "mixed_tense ([0-9]+)", "container ([0-9]+)", "preposition_split ([0-9]+)", "short_name ([0-9]+)", "worker_name ([0-9]+)", "taken_word ([0-9]+)", "bare_participle ([0-9]+)"}},
  {recipe = "errors", args = {}, counts = {"error_alias ([0-9]+)", "optional_tag ([0-9]+)", "set_fallback ([0-9]+)", "placeholder ([0-9]+)"}},
  {recipe = "nest_depth", args = {"min=4"}, counts = {"nested ([0-9]+)"}},
  {recipe = "boundaries", args = {}, counts = {"fixed ([0-9]+)"}},
  {recipe = "stack", args = {}, counts = {"([0-9]+) to stack"}},
  {recipe = "methods", flags = {"--undo-on-stop"}, args = {"root=app/main.roc,app/Specs.roc"}, counts = {"rewritten ([0-9]+)"}},
}
for h in hunts do
  local argv = {"shale"}
  for f in get(h, "flags", {}) do push(argv, f) end
  push(argv, real("cookbook:roc/" .. h.recipe .. ".shale"))
  push(argv, "glob=app/**/*.roc")
  for a in h.args do push(argv, a) end
  -- `whole`, not `tail`: `tail` cuts a long line, and name_hunt's summary
  -- runs past the cut to its last count, `bare_participle`.
  local r = run(argv, {cwd = ".", timeout_ms = 600000, whole = 1000000})
  local last = ""
  for l in lines(trim(r.out)) do
    if not starts_with(l, "──") and trim(l) ~= "" then last = l end
  end
  local zero = r.code == 0
  for c in h.counts do
    local got = re_find(last, c)
    if got == nil or tonumber(got.groups[1]) ~= 0 then zero = false end
  end
  say(zero, "hunt " .. h.recipe .. ": " .. last)
  if not zero then print(r.out) end
end

-- 4. The demo, through the host: the sample's page, exactly as frozen.
local demo = run({"zig", "build", "demo", "--", "/chat/channel/general/gopher-roc", "demo/data/chat/channel/general/gopher-roc/transcript"}, {timeout_ms = 300000, whole = 1000000})
say(demo.code == 0 and demo.out == read("demo/gopher-roc.html"), "the demo's page: exactly demo/gopher-roc.html")
if demo.code ~= 0 then print(demo.out) end

-- 5. The host's tests.
local zig_tests = run({"zig", "build", "test", "--summary", "all"}, {timeout_ms = 300000, whole = 1000000})
local summary = re_find(zig_tests.out, "Build Summary: [^\n]*")
say(zig_tests.code == 0, "zig build test: " .. (summary and summary.text or "no summary"))
if zig_tests.code ~= 0 then print(zig_tests.out) end

-- 6. The end to end, last.
local e2e = run({"zig", "build", "end-to-end"}, {timeout_ms = 300000, whole = 1000000})
for l in re_lines(e2e.out, "^(PASS|FAIL) ") do print("  " .. l.text) end
local passed_all = re_find(e2e.out, "end-to-end: every step passed, in [0-9]+ ms")
say(e2e.code == 0 and passed_all ~= nil, "the end to end: " .. (passed_all and passed_all.text or "failed"))
if e2e.code ~= 0 then print(e2e.out) end

if board.failed > 0 then fail("verify: " .. board.failed .. " failed") end
print("verify: every check passed")
